  "topPoints": [
    {
      "value": "Rubbery, ear-shaped jelly, tan-brown, on dead or dying elder.",
      "sources": [
        "fn",
        "wf",
        "wt"
      ]
    },
    {
      "value": "Outside velvety with fine hairs; the inside smooth or wrinkled and shiny.",
      "sources": [
        "fn",
        "wp",
        "wt"
      ]
    },
    {
      "value": "Flesh thin, translucent and jelly-like.",
      "sources": [
        "wf",
        "wt"
      ]
    },
    {
      "value": "Found all year round, most in late summer and autumn.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "On dead and dying elder; sometimes on other broadleaved trees and shrubs such as sycamore, beech and ash.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
