  "topPoints": [
    {
      "value": "Underneath: pale yellow pores — no gills — that turn blue-green at once when pressed.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Cap chestnut to bay-brown, velvety when young, smooth and a little sticky when wet.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Stem brown and streaky, with no net pattern and no ring.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Flesh whitish to pale yellow, turning slightly blue when cut.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Common, especially under conifers, also in mixed woodland.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Woodland — under conifers and in mixed woods, on the ground.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
