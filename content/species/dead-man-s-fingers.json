        "wt"
      ]
    },
    {
      "value": "Cut open: tough white flesh inside a black crust.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "At the base of stumps of beech and other broadleaved trees.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
