  "topPoints": [
    {
      "value": "Small grey-brown cap, 1–3 cm, egg-shaped then flat, covered at first in white hairs like a hare's foot.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Gills white, then black, melting into ink within hours.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "On rich soil, leaf litter, woodchip and compost.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Humus-rich soil, leaf litter, woodchip mulch, compost and dung.",
