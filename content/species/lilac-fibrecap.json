{
  "slug": "lilac-fibrecap",
  "inatId": 1288764,
  "scientific": "Inocybe lilacina",
  "english": "Lilac Fibrecap",
  "olderNames": [
    "Inocybe geophylla var. lilacina"
  ],
  "edibility": {
    "value": "deadly",
    "sources": [
      "fn",
      "wf-ad"
    ]
  },
  "edibilityNote": {
    "value": "Contains muscarine: sweating, drooling and tears within half an hour, then stomach pains, sickness and blurred vision.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Small lilac cap, 1–4 cm, silky, with a pointed hump that turns ochre-brown.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Gills crowded, creamy grey turning clay brown — not purple; dull brown spore print.",
      "sources": [
        "fn",
        "wp",
        "wf-ad"
      ]
    },
    {
      "value": "Stem lilac, thin, smooth and silky; no ring.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Smells mealy or earthy.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Beside paths and on roadside verges under broadleaved trees, and in mixed woods; less often under conifers.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "seasonMonths": {
    "value": [
