  "topPoints": [
    {
      "value": "Grey-brown cap, 8–15 cm, dotted with grey patches of veil that wash off easily.",
      "sources": [
        "fn",
        "wf-pc"
      ]
    },
    {
      "value": "A large ring on the stem, grooved (lined) on its upper side.",
      "sources": [
        "fn",
        "wf-pc"
      ]
    },
    {
      "value": "White, crowded gills; white spore print.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "A swollen stem base; the bag (volva) around it is barely seen on grown ones.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In broadleaved and mixed woods, often near the edges.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Broadleaved and mixed woods, often most plentiful near the edges.",
    "sources": [
      "fn",
