  "topPoints": [
    {
      "value": "A bracket shaped like a tongue or a slab of liver, red to reddish-brown, on a tree trunk.",
      "sources": [
        "fn",
        "wf",
        "wp",
        "wt"
      ]
    },
    {
      "value": "Cut it and it oozes a blood-red juice.",
      "sources": [
        "fn",
        "wf",
        "wp",
        "wt"
      ]
    },
    {
      "value": "Underneath: pale straw-yellow pores that turn reddish-brown with age — no gills.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Low on the trunks of oak and sweet chestnut, often old or dead trees.",
      "sources": [
        "fn",
        "wt"
      ]
    }
  ],
  "habitat": {
    "value": "Low on the trunks or roots of oak and sweet chestnut, living or long dead.",
    "sources": [
      "fn",
      "wt"
    ]
  },
