  "topPoints": [
    {
      "value": "A cream to clay-coloured cap like half an egg, 2–9 cm, shiny and often wrinkled.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills mottled, turning black; black spore print.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Tall, thin stem with a small ring that soon blackens.",
      "sources": [
        "wf",
        "wp"
      ]
    },
    {
      "value": "On or beside dung, especially horse dung, in grazed fields.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
