  },
  "edibilityNote": {
    "value": "Many guides list it as poisonous, though the effects are unclear (Wikipedia); a few European guides call it edible. First Nature: inedible and probably poisonous.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
