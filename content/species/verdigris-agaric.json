      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "A vivid blue-green, very slimy cap, 2–8 cm, flecked with white veil near the edge; it fades to yellow-ochre.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Gills grey to clay-brown, turning purple-brown, with white edges.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "A fragile ring that soon turns brown; below it the stem is blue-green with white scales.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In grassy woods, pastures and on roadside verges.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "In grass and leaf litter in woods and pastures, and on roadside verges.",
    "sources": [
      "fn",
      "wp"
    ]
  },
