{
  "slug": "blusher",
  "inatId": 67661,
  "scientific": "Amanita rubescens",
  "english": "Blusher",
  "olderNames": [],
  "edibility": {
    "value": "edible-cooked",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "Poisonous raw — it must be cooked thoroughly. It is easily mistaken for the poisonous Panthercap, so many foragers leave it alone.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Flesh and bruised gills slowly turn pink to red (\"blushing\") — the key feature.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Cap pinkish-brown, dotted with off-white, grey or pinkish warts.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "A ring on the stem with fine grooves on its upper side.",
      "sources": [
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills white and crowded, free of the stem, often with pink or rusty spots.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Stem base swollen, without a rim; a bag shows only on very young ones.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "In woods of all kinds; common under conifers on poor soils.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Woodland of all kinds, broadleaved and coniferous; especially common in conifer woods on poor, acid soils.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
    "value": [
      6,
      7,
      8,
      9,
      10
    ],
    "sources": [
      "fn",
      "wf"
    ]
  },
  "sporePrint": {
    "value": "White",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "features": {
