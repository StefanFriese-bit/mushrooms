  "topPoints": [
    {
      "value": "A small bolete growing out of a Common Earthball — nothing else looks like this.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Yellowish-brown to olive cap, 2–6 cm, downy at first.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Underneath: yellow pores darkening to olive-brown; little or no blueing.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "A curved, yellowish stem tapering to the base.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
