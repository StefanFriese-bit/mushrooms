{
  "slug": "common-rustgill",
  "inatId": 194304,
  "scientific": "Gymnopilus penetrans",
  "english": "Common Rustgill",
  "olderNames": [
    "Flammula penetrans",
    "Gymnopilus hybridus"
  ],
  "edibility": {
    "value": "poisonous",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "edibilityNote": {
    "value": "Inedible and possibly poisonous (both sites); First Nature advises treating every rustgill as toxic, as several are seriously poisonous and some elsewhere contain hallucinogens.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "A fiery orange-brown cap, 2–8 cm, silky or finely velvety, paler at the edge.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Gills yellow at first, soon rusty brown with darker rusty spots; rusty-orange spore print.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "A yellowish to orange-brown stem with fine white fibres; no ring.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "In tufts on conifer stumps and logs, and on woodchip.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "In tufts on conifer stumps, logs and debris; sometimes broadleaved wood; increasingly on woodchip mulch.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
    "value": [
      6,
      7,
      8,
