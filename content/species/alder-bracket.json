  "topPoints": [
    {
      "value": "Semicircular brackets up to 10 cm, in tiers that merge; apricot to rusty-brown, ageing almost black.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Underneath: silvery-cream pores, turning buff, then brown.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Almost always on dying or dead alder; rarely birch or beech.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
