  "topPoints": [
    {
      "value": "Pink cap, 2–6 cm, from almost white to deep pink, with a darker centre and fine lines towards the edge.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills pale pink to off-white; white spore print.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Pink stem, often tapering upwards; no ring.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "In leaf litter in broadleaved and mixed woods, especially under beech.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Leaf litter in broadleaved and mixed woods, especially under beech; also verges by beech hedges.",
