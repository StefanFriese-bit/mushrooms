  "topPoints": [
    {
      "value": "Egg-yolk yellow cap, 4–12 cm, covered in tiny purple-red scales.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills egg-yolk yellow and crowded; white spore print.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Stem yellow, covered in purple-red scales.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "On rotting conifer stumps and fallen trunks.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "On rotting conifer stumps, roots and fallen trunks, especially pine and spruce; rarely broadleaved stumps.",
    "sources": [
      "fn",
      "wf"
    ]
  },
