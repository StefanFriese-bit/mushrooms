  "topPoints": [
    {
      "value": "Tiny white parachute-like caps, 0.3–2 cm, deeply grooved, with a scalloped edge.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Very widely spaced white gills joined to a collar that stands free of the stem.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "A thin, shiny, wiry stem, dark brown to black below.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In groups on dead twigs, wood and leaf litter, especially beech.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Dead wood, twigs and woody debris of broadleaved trees, especially beech; sometimes rotting leaves.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "seasonMonths": {
