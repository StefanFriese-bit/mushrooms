{
  "slug": "stinking-dapperling",
  "inatId": 58694,
  "scientific": "Lepiota cristata",
  "english": "Stinking Dapperling",
  "olderNames": [
    "Agaricus miamensis",
    "Lepiota felinoides"
  ],
  "edibility": {
    "value": "poisonous",
    "sources": [
      "wf",
      "wp",
      "fn"
    ]
  },
  "edibilityNote": {
    "value": "Said to cause stomach upsets; like most small dapperlings it is treated as poisonous — some of its relatives are deadly.",
    "sources": [
      "wp",
      "fn"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Small white cap, 1–6 cm, with red-brown scales in rings, darkest in the centre.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Strong unpleasant smell, like rubber or coal gas.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills white to cream, free and crowded; white spore print.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "A small fragile ring that is soon lost; thin pale stem.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Mixed woods, parks, gardens and other shady places with rich soil; usually in groups.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
    "value": [
      7,
      8,
      9,
      10,
      11
    ],
    "sources": [
      "fn",
      "wf"
    ]
  },
