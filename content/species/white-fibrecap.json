  "topPoints": [
    {
      "value": "Small silky white to cream cap, 1–4 cm, with a pointed hump; it turns ochre-brown from the centre with age.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Gills crowded, creamy grey turning clay brown; dull brown spore print.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Thin silky stem with a small bulb at the base; no ring.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Beside paths and on verges under broadleaved trees, and in mixed woods.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Beside paths, on verges and on disturbed soil under broadleaved trees and in mixed woods; less often under conifers.",
    "sources": [
      "fn",
      "wp"
    ]
  },
