  "topPoints": [
    {
      "value": "Grey-brown to olive-brown cap, 3–12 cm, slimy when wet and radially wrinkled, with a broad hump.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills white to cream, widely spaced; white spore print.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "A tall, thin, grooved stem with a long root reaching down to buried wood; no ring.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Near beech and other broadleaved trees, alone or a few together.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Under or near broadleaved trees, especially beech, rooting into buried wood; alone or a few together.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
    "value": [
      6,
