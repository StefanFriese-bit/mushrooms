  "topPoints": [
    {
      "value": "Small bright orange to orange-red cap, 2–5 cm, dry and slightly scurfy, fading with age.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Smells of honey, most of all when rubbed or drying.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Widely spaced gills, paler than the cap; no ring.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In old, unfertilised grassland — lawns, churchyards, dunes.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
