  },
  "topPoints": [
    {
      "value": "A bracket growing straight out of a tree: fan-shaped shelves, often in overlapping tiers.",
      "sources": [
        "fn",
        "wp",
        "wt"
      ]
    },
    {
      "value": "Bright sulphur-yellow to orange when young, fading to cream and whitish with age.",
      "sources": [
        "fn",
        "wp",
        "wt"
      ]
    },
    {
      "value": "Underneath: tiny pores, white to pale yellow — no gills.",
      "sources": [
        "fn",
        "wp",
        "wt"
      ]
    },
    {
      "value": "Flesh soft, moist and crumbly when young.",
      "sources": [
        "fn",
        "wt"
      ]
    },
    {
      "value": "Mainly on oak; also sweet chestnut, cherry, willow — and yew.",
      "sources": [
        "fn",
        "wt"
      ]
    }
  ],
  "habitat": {
    "value": "On the trunks of living and dead broadleaved trees — mainly oak, also sweet chestnut, beech, cherry and willow; sometimes on yew.",
    "sources": [
      "fn",
      "wt"
    ]
  },
