  "topPoints": [
    {
      "value": "Thin upright sticks 3–8 cm tall, often forked like small antlers or a snuffed-out candle wick.",
      "sources": [
        "fn",
        "wf",
        "wp",
        "wt"
      ]
    },
    {
      "value": "Black and finely hairy at the base, white and powdery at the tips; later black all over.",
      "sources": [
        "fn",
        "wf",
        "wt"
      ]
    },
    {
      "value": "On dead wood and stumps of broadleaved trees, all year round.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Fallen branches and rotting stumps of broadleaved trees; rarely on conifer stumps.",
    "sources": [
      "fn",
      "wf"
    ]
  },
