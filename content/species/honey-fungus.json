  },
  "topPoints": [
    {
      "value": "Honey-yellow to brown caps, darker in the centre, often with small dark scales; in large clusters on wood.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "A thick whitish to yellow ring high on the stem.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills pale, turning yellowish, later with rusty spots; white to pale cream spore print.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "On living and dead broadleaved trees, stumps and roots; sometimes in grass above buried roots.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "In large clusters on living and dead broadleaved trees (orchard trees too), stumps and roots; sometimes in grass above buried roots.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
