  "topPoints": [
    {
      "value": "Thin, whitish crusts and small brackets, spreading in patches, often on the undersides of fallen branches.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "The lower surface is covered in a net of wrinkles and ridges, white turning ochre.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Top of the little brackets finely hairy, white to greyish.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Dead fallen broadleaved branches and twigs, mostly on the undersides; commonly ash.",
    "sources": [
      "fn",
      "wf"
    ]
