  "edibilityNote": {
    "value": "Too bitter to eat, even cooked. Wikipedia lists it as poisonous; Wild Food UK says it is not. First Nature: it can be confused with the more seriously poisonous Devil’s Bolete.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
