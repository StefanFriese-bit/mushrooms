    ]
  },
  "topPoints": [
    {
      "value": "A pale smoky-grey to beige cap, 5–15 cm.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Underneath: lemon-yellow pores that bruise blue-green.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Stem yellow at the top and red below, covered in a pale net.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Cut it: the pale yellow flesh turns white, then blue.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Under beech and oak, mostly on chalky or neutral soil.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Under beech and oak, mostly on chalky or neutral soil; sometimes other trees, rarely conifers.",
    "sources": [
      "fn",
      "wf"
    ]
  },
