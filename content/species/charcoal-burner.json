  "topPoints": [
    {
      "value": "Gills white, greasy to the touch and flexible: they bend without breaking, unlike other brittlegills.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Cap very variable: purple, wine, grey, olive or brown, often mixed; greasy when wet.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Stem white and firm, with no ring.",
      "sources": [
        "fn",
        "wf",
        "wt"
      ]
    },
    {
      "value": "Under broadleaved trees, especially beech and oak.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
