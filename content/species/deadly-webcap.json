{
  "slug": "deadly-webcap",
  "inatId": 500053,
  "scientific": "Cortinarius rubellus",
  "english": "Deadly Webcap",
  "olderNames": [
    "Cortinarius speciosissimus",
    "Cortinarius rainierensis"
  ],
  "edibility": {
    "value": "deadly",
    "sources": [
      "fn",
      "wf",
      "wp",
      "wt-poison",
      "wf-poison"
    ]
  },
  "edibilityNote": {
    "value": "Contains orellanine, which destroys the kidneys. People have eaten it thinking it was a chanterelle. Do not taste even a small piece.",
    "sources": [
      "fn",
      "wp",
      "wt-poison",
      "wf"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Cap tawny orange-brown to reddish brown, dry and finely scaly, with a pointed bump in the middle.",
      "sources": [
        "fn",
        "wf",
        "wp",
        "wt-poison"
      ]
    },
    {
      "value": "Gills fairly widely spaced, paler at first, then rusty brown.",
      "sources": [
        "fn",
        "wf",
        "wp",
        "wt-poison"
      ]
    },
    {
      "value": "Yellowish zig-zag bands on the stem — the remains of a cobweb-like veil.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Smells faintly of radish.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Under conifers, especially pine and spruce, on wet, acid ground.",
      "sources": [
        "fn",
        "wf",
        "wt-poison"
      ]
    },
    {
      "value": "Uncommon; more frequent the further north you go in Britain.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Conifer woods, especially pine and spruce, on wet, acid ground; sometimes mixed woods. Uncommon, mostly in the north.",
    "sources": [
      "fn",
      "wf",
      "wp",
      "wt-poison"
    ]
  },
