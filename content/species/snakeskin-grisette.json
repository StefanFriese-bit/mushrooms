  "edibility": {
    "value": "edible-some-react",
    "sources": [
      "wf",
      "wp",
      "fn"
    ]
  },
  "edibilityNote": {
    "value": "Its edibility is disputed: Wild Food UK and Wikipedia call it edible but not recommended, while First Nature reports it as at least slightly poisonous. All warn that it is easily confused with the poisonous Panthercap and the deadly Amanitas — not for beginners.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "A brown cap, 6–12 cm, with charcoal-grey patches that rub off and a strongly lined edge.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "No ring; the stem is banded with grey zig-zags like snakeskin.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "A fragile bag (volva) at the base that soon collapses into grey patches.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "White gills, free of the stem; white spore print.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Broadleaved and mixed woods, often in parkland.",
    "sources": [
      "fn",
      "wf"
    ]
  },
