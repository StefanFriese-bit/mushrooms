  "edibilityNote": {
    "value": "Edible when cooked, but not highly rated; peel off the slimy cap skin first. Old ones turn rubbery.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
