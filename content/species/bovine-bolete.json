    ]
  },
  "topPoints": [
    {
      "value": "A pale orange-yellow to clay-brown cap, 3–10 cm, sticky when wet, with a paler wavy edge.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Underneath: large, angular yellow to olive pores, divided inside like a honeycomb.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "No ring on the stem.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Under Scots pine and other pines, often beside paths.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Under pines, especially Scots pine, and sometimes other conifers; often beside paths and in clearings.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
