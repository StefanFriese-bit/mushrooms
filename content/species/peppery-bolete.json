{
  "slug": "peppery-bolete",
  "inatId": 147354,
  "scientific": "Chalciporus piperatus",
  "english": "Peppery Bolete",
  "olderNames": [
    "Boletus piperatus",
    "Suillus piperatus"
  ],
  "edibility": {
    "value": "edible-cooked",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "edibilityNote": {
    "value": "Very hot and peppery: dried and ground as a spice, or cooked by people who like chillies. Wikipedia says it contains toxins and is usually considered inedible; cook it well to lower the risk of a stomach upset.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "A small bolete: yellow-orange to cinnamon-brown cap, 2–8 cm, shiny when dry.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Underneath: rusty-orange to cinnamon pores that do not change colour when bruised.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "A thin stem, bright chrome-yellow at the very base.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Under birch and pine, often where Fly Agarics grow.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Mixed woodland, mostly with birch and pine, often where Fly Agarics grow.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
    "value": [
      8,
      9,
      10
    ],
    "sources": [
      "fn",
      "wf"
    ]
  },
  "sporePrint": {
