  "edibilityNote": {
    "value": "Cook it soon after picking, before it turns to ink. Wild Food UK: pick only ones still carrying the glistening grains (an inedible lookalike lacks them).",
    "sources": [
      "wp",
      "wf"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
