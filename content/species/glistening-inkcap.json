    ]
  },
  "topPoints": [
    {
      "value": "Tan to orange-brown bell-shaped caps, 1–4 cm, grooved, dusted with glistening white grains that rain washes off.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills white, then brown, then black, melting into ink.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "In dense tufts on and around broadleaved stumps and buried roots.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "In dense tufts on or beside broadleaved stumps, dead roots and buried wood.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
