  "topPoints": [
    {
      "value": "Pale buff caps, browner in the centre, 4–10 cm, often cracking in dry weather.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Gills cream, turning grey-brown, then brown; tobacco-brown spore print.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "A large, lasting ring hanging from the stem.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In tufts on poplar and willow — on stumps, logs and holes in standing trees.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "In tufts on poplar and willow — stumps, standing dead or dying trees; other broadleaved trees; also woodchip mulch.",
    "sources": [
