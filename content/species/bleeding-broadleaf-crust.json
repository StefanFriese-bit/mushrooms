    {
      "value": "A tough, leathery crust lying flat on dead wood of broadleaved trees, especially hazel.",
      "sources": [
        "fn",
        "ns"
      ]
    },
    {
      "value": "Smooth surface, buff to pale pinkish-brown.",
      "sources": [
        "fn",
        "ns"
      ]
    },
    {
      "value": "Turns red where it is scratched or bruised.",
      "sources": [
        "fn",
        "ns"
      ]
    }
  ],
  "habitat": {
