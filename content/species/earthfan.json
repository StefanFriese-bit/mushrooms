    {
      "value": "Brown, fibrous fans, each up to 6 cm wide, forming rosettes up to 15 cm across, darkening with age; paler, fringed edges.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "On sandy soil under pines, often wrapped round twigs, roots and plant stems.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Seen mostly from July to December.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Dry, sandy soil under pines and other conifers; less often heaths and broadleaved trees.",
