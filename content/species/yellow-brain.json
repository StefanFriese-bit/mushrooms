  "topPoints": [
    {
      "value": "Bright golden-yellow jelly, 2–9 cm, lobed and folded like a brain.",
      "sources": [
        "fn",
        "wf",
        "wp",
        "wt"
      ]
    },
    {
      "value": "Shrivels and turns orange in dry weather, and swells again after rain.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "On dead branches of broadleaved trees — often birch, hazel and gorse.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Dead branches and twigs of broadleaved trees, often birch, hazel and gorse; it lives on crust fungi in the wood.",
    "sources": [
      "fn",
      "wf"
    ]
  },
