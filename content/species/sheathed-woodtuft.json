{
  "slug": "sheathed-woodtuft",
  "inatId": 153033,
  "scientific": "Kuehneromyces mutabilis",
  "english": "Sheathed Woodtuft",
  "olderNames": [
    "Pholiota mutabilis"
  ],
  "edibility": {
    "value": "edible-cooked",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "Every source warns it is very easily mistaken for the deadly Funeral Bell — sometimes only a microscope tells them apart. First Nature advises looking, not cooking.",
    "sources": [
      "fn",
      "wp",
      "wf-fb"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Clusters of orange-tan caps; each cap dries paler from the centre out, so the edge stays darker (two-toned).",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Stem pale and smooth above a small ragged ring, dark and shaggy with scales below it.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills pale ochre turning cinnamon; rusty-brown spore print.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "On dead broadleaved wood, especially birch, all year round.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "On stumps, logs and felled trunks of broadleaved trees, especially birch, in large clusters.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
    "value": [
      1,
