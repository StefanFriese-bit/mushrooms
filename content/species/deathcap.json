{
  "slug": "deathcap",
  "inatId": 52135,
  "scientific": "Amanita phalloides",
  "english": "Deathcap",
  "olderNames": [
    "Agaricus phalloides",
    "Amanita dunensis"
  ],
  "edibility": {
    "value": "deadly",
    "sources": [
      "fn",
      "wp",
      "wt",
      "wt-poison",
      "wf-poison"
    ]
  },
  "edibilityNote": {
    "value": "The cause of most deaths from mushroom poisoning: half a cap can kill, and cooking or freezing does not destroy the poison. Do not taste it.",
    "sources": [
      "fn",
      "wp",
      "wt",
      "wf"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Cap usually olive-green, yellowish or bronze, with fine darker streaks — but young caps and a white form are white.",
      "sources": [
        "fn",
        "wf",
        "wp",
        "wt",
        "wf-poison"
      ]
    },
    {
      "value": "Gills white, later cream (at most faintly pink) — never brown.",
      "sources": [
        "fn",
        "wf",
        "wp",
        "wt"
      ]
    },
    {
      "value": "Swollen stem base in a white, bag-like volva — scrape away the soil and leaves to see it.",
      "sources": [
        "fn",
        "wf",
        "wp",
        "wt"
      ]
    },
    {
      "value": "A floppy white ring hanging from the upper stem.",
      "sources": [
        "fn",
        "wp",
        "wt"
      ]
    },
    {
      "value": "Grows under broadleaved trees, especially oak and beech.",
      "sources": [
        "fn",
        "wf",
        "wp",
        "wt"
      ]
    },
    {
      "value": "White spore print.",
      "sources": [
        "fn",
        "wf",
        "wt",
        "wf-poison"
      ]
    }
  ],
  "habitat": {
    "value": "Broadleaved woodland, especially under oak, also beech and other trees; occasionally with conifers.",
    "sources": [
      "fn",
      "wf",
      "wp",
      "wt",
      "wf-poison"
    ]
  },
