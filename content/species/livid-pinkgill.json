{
  "slug": "livid-pinkgill",
  "inatId": 510199,
  "scientific": "Entoloma sinuatum",
  "english": "Livid Pinkgill",
  "olderNames": [
    "Agaricus sinuatus",
    "Entoloma lividum",
    "Entoloma eulividum"
  ],
  "edibility": {
    "value": "deadly",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "Severe vomiting and diarrhoea that can last two days; deaths have been reported. It causes about one in ten mushroom poisonings in Europe.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Large ivory-white to pale grey-brown cap, often with a broad hump; it darkens with age.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Gills yellowish at first, turning pink as the spores ripen; pink spore print.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Smell usually unpleasant or rancid — but it can smell of flour, so smell alone is not enough.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In broadleaved woods, mainly under oak and beech, from summer to late autumn.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Broadleaved woods, mainly under oak and beech (less often birch), on clay or chalky soil; sometimes in nearby parks and grassy places.",
    "sources": [
      "fn",
      "wp"
    ]
  },
