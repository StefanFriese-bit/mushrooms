  "topPoints": [
    {
      "value": "Dense clusters of small brown bell-shaped caps, 0.5–3 cm, drying pale ochre from the edge.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Many stems fused together at the base.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Gills grey-brown with white edges, turning dark brown; dark purple-brown spore print.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Grassy open woodland, on soil over buried wood and fallen timber.",
    "sources": [
      "fn",
      "wp"
    ]
  },
