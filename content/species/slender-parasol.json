{
  "slug": "slender-parasol",
  "inatId": 351447,
  "scientific": "Macrolepiota mastoidea",
  "english": "Slender Parasol",
  "olderNames": [
    "Lepiota mastoidea",
    "Macrolepiota rickenii",
    "Macrolepiota konradii"
  ],
  "edibility": {
    "value": "edible-cooked",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "Good to eat, without the tough stem. First Nature and Wikipedia warn that the Shaggy Parasol and its relatives look similar and can cause very serious stomach upsets: check that the cut flesh does not turn orange-red.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "A pale cap, about 12 cm (up to 15), with fine brown scales on a white background and a pronounced central bump.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "A slender stem with fine brownish scales — only a faint snakeskin — and a movable double ring.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "White, crowded gills, free of the stem; white spore print.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "The cut flesh does not turn red or orange.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "In grassy woodland clearings and edges on chalky soil; also dunes.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Grassy woodland clearings and edges, grassland and moors on chalky soil; also sand dunes.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
    "value": [
