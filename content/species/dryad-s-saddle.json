{
  "slug": "dryad-s-saddle",
  "inatId": 940028,
  "scientific": "Cerioporus squamosus",
  "english": "Dryad's Saddle",
  "olderNames": [
    "Polyporus squamosus"
  ],
  "edibility": {
    "value": "edible-cooked",
    "sources": [
      "wf",
      "fn"
    ]
  },
  "edibilityNote": {
    "value": "Eat only young, tender ones; they soon turn leathery and then corky.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "A large fan- or saddle-shaped bracket, ochre-yellow with rings of dark brown scales.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Underneath: large, angular, off-white pores that run down the stem — no gills.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "A short, thick stem at one side, darkening to black at the base.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Smells floury, or of watermelon rind when young.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "On broadleaved trees and stumps, from spring.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "On living and dead broadleaved trees and stumps.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "seasonMonths": {
    "value": [
      5,
      6,
      7,
      8
    ],
    "sources": [
      "fn",
      "wf"
    ]
  },
