  "topPoints": [
    {
      "value": "A large fan- or saddle-shaped bracket, ochre-yellow with rings of dark brown scales.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Underneath: large, angular, off-white pores that run down the stem — no gills.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "A short, thick stem at one side, darkening to black at the base.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Smells floury, or of watermelon rind when young.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "On broadleaved trees and stumps, from spring.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "On living and dead broadleaved trees and stumps.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
