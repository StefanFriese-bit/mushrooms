  "topPoints": [
    {
      "value": "A hard, hoof-shaped bracket, up to 30 cm across, with a red to orange band and a paler or orange edge.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Underneath: cream to pale yellow, with tiny round pores.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "On living or dead conifers, sometimes birch; it lasts for years.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Living and dead conifers, sometimes birch. Rare in Britain and Ireland.",
