  "topPoints": [
    {
      "value": "A dark grey to black trumpet, hollow right down to the base.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Outside grey and almost smooth, finely wrinkled — no proper gills.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Hard to spot: in clusters in leaf litter, mostly under beech.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "In leaf litter in broadleaved woods, mostly under beech, also oak; usually in clusters.",
    "sources": [
      "fn",
      "wf"
    ]
  },
