  "topPoints": [
    {
      "value": "Small greasy cap, yellow-orange to orange-red, with fine lines at a paler edge.",
      "sources": [
        "fn",
        "ns"
      ]
    },
    {
      "value": "Gills broadly attached, running down the stem.",
      "sources": [
        "fn",
        "ns"
      ]
    },
    {
      "value": "Slender stem, red at the top and paler lower down.",
      "sources": [
        "fn",
        "ns"
      ]
    },
    {
      "value": "In old, unfertilised grassland, in autumn.",
      "sources": [
        "fn",
        "ns"
      ]
    }
  ],
