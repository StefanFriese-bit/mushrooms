  "topPoints": [
    {
      "value": "Small, slimy orange-brown cap, 1.5–5 cm, with deep grooves towards a toothed edge.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills pale grey, turning salmon pink, running a little down the stem.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Slimy orange stem; no ring.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "On heaths and acid grassland, among short grass and moss.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Heaths and acid upland grassland among short grass and moss; sometimes lawns.",
    "sources": [
      "fn",
      "wf"
    ]
  },
