    ]
  },
  "edibilityNote": {
    "value": "Very bitter and too small to eat; First Nature reports that in some parts of the world it has caused vomiting.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Small kidney- or shell-shaped caps, 0.5–3 cm, tan to orange-brown, on a short stub of a stem at the side.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Crowded pale tan gills, joined by cross-veins into a mesh.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In tufts and overlapping clusters on dead broadleaved wood, especially oak.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Fallen trunks, large branches and stumps of broadleaved trees, especially oak, beech and birch.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "seasonMonths": {
    "value": [
