  "topPoints": [
    {
      "value": "Orange-brown to tan lobes like the fingers of a fawn kid glove, 8–20 cm across, wrapped round hazel stems.",
      "sources": [
        "fn",
        "wp",
        "wt"
      ]
    },
    {
      "value": "Tiny dark dots on the surface — the openings that release the spores.",
      "sources": [
        "fn",
        "wt"
      ]
    },
    {
      "value": "Only on old hazel in ancient, damp western woods (Atlantic rainforest).",
      "sources": [
        "fn",
        "wp",
        "wt"
      ]
    },
    {
      "value": "Protected and very rare: never pick it.",
      "sources": [
        "fn",
        "wt"
      ]
    }
  ],
  "habitat": {
    "value": "Old hazel stems in ancient, damp Atlantic woodland, where it grows over the Glue Crust fungus.",
    "sources": [
      "fn",
      "wp",
      "wt"
    ]
  },
