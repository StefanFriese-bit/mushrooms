    ]
  },
  "edibilityNote": {
    "value": "Some call it edible, but webcaps include seriously poisonous and deadly species, and it is risky to eat (both sites); First Nature also asks that this rare mushroom be left where it grows.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Deep violet-purple all over — cap, gills, stem and flesh; cap 6–15 cm, finely scaly.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Gills purple, turning rusty brown as the spores ripen; rusty-brown spore print.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "A thick purple stem, swollen at the base; a cobweb-like veil when young.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Rare: in broadleaved woods on chalk or limestone, sometimes under conifers.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Broadleaved woods and occasionally conifers, on chalky or limestone soil; rare in Britain.",
    "sources": [
      "fn",
      "wp"
    ]
  },
