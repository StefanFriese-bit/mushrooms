    ]
  },
  "topPoints": [
    {
      "value": "A large, golden- to walnut-brown cap, 10–30 cm, felty, with a rolled, wavy edge and a sunken centre.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "A thick, off-centre stem covered in dark brown to black velvet.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Crowded cream-yellow gills running down the stem, turning brown.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "On the stumps and roots of dead conifers, mostly pine.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
