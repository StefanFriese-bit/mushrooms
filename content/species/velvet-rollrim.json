  "edibilityNote": {
    "value": "Inedible and possibly poisonous (First Nature); it contains toxins that can upset the stomach, and poisonings have been reported (Wikipedia). Young ones are eaten in parts of eastern Europe.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
