  "topPoints": [
    {
      "value": "Small cap, 1–7 cm, egg-shaped and chrome yellow at first, then flat, fading to grey from the edge.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Gills pale yellow, turning cinnamon; rusty-brown spore print.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Fragile, hollow, pale stem with no ring.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "On manured grass, straw, dung and woodchip; each lasts only a day or so.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
