      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "A creamy-white cap, 5–12 cm, that develops rusty-brown spots and blotches.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Crowded white gills, also spotting rusty brown with age.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "A white stem, often rooting, spotting brown; no ring.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Mostly under pines and other conifers, in needle litter.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Needle litter and rotting buried wood, mostly under conifers; sometimes broadleaved woods and heaths.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
    "value": [
      6,
      7,
      8,
      9,
      10,
      11
    ],
    "sources": [
      "fn"
    ]
  },
