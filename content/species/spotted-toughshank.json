{
  "slug": "spotted-toughshank",
  "inatId": 118168,
  "scientific": "Rhodocollybia maculata",
  "english": "Spotted Toughshank",
  "olderNames": [
    "Collybia maculata"
  ],
  "edibility": {
    "value": "not-edible",
    "sources": [
      "fn",
