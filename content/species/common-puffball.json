{
  "slug": "common-puffball",
  "inatId": 48443,
  "scientific": "Lycoperdon perlatum",
  "english": "Common Puffball",
  "olderNames": [],
  "edibility": {
    "value": "edible-cooked",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "edibilityNote": {
    "value": "Only while it is pure white inside; peel off the tough skin before cooking.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "A small white pear-shaped puffball, 3 to 6 cm across, with a stem-like base.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Covered in tiny pearl-like warts that rub off and leave faint scars.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "When ripe a hole opens on top and the brown spores puff out.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Cut it top to bottom: it must be pure white and even inside. The outline of a cap and stem means a young Amanita, such as a Deathcap.",
      "sources": [
        "fn",
        "wf",
        "fn-dc"
      ]
    },
    {
      "value": "In woodland leaf litter, also pasture and heaths, usually in groups.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Woodland leaf litter; also pasture, commons and heaths. Usually in groups.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
    "value": [
      7,
