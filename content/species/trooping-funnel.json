{
  "slug": "trooping-funnel",
  "inatId": 451026,
  "scientific": "Infundibulicybe geotropa",
  "english": "Trooping Funnel",
  "olderNames": [
    "Clitocybe geotropa",
    "Clitocybe maxima"
  ],
  "edibility": {
    "value": "edible-cooked",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "Pick only big ones: the deadly Fool's and Ivory Funnels look alike but never grow anywhere near as large. Cook it; the tough stems are usually discarded.",
    "sources": [
      "wf",
      "wp",
      "fn"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Large creamy-buff cap, 10–20 cm, funnel-shaped with a raised centre and an inrolled edge.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills crowded, the colour of the cap, running far down the stem.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Tall, tough stem, thickening towards the base; no ring.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "In troops or rings in woodland clearings, parks and verges, late in the year.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "In troops or rings in broadleaved woodland clearings, parkland and on verges beside hedges.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "seasonMonths": {
    "value": [
