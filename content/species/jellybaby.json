  "topPoints": [
    {
      "value": "Small, rubbery, jelly-like \"heads\" up to 1.5 cm, greenish-yellow to olive, on a yellowish stem 2–6 cm tall.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "The head has a wavy, rolled edge and a smooth underside — no gills or ridges.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "In groups on damp soil and moss in woods, often beside paths and ditches.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Damp soil and moss in broadleaved and conifer woods, often beside paths and ditches.",
