  "topPoints": [
    {
      "value": "A felty rosette or fan, 5–20 cm, pale pink to reddish-brown on top — or a shapeless pale lump.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Underneath: white to buff angular pores that become maze-like and reddish-brown.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Bruises reddish-brown where handled, and can weep red droplets when young.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "In grass or soil around stumps, growing from buried roots of broadleaved trees.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "In grass or soil around broadleaved stumps, from buried roots; sometimes on woodchip.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
    "value": [
      9,
      10,
      11
    ],
