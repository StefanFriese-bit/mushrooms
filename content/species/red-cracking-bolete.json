{
  "slug": "red-cracking-bolete",
  "inatId": 438013,
  "scientific": "Xerocomellus chrysenteron",
  "english": "Red Cracking Bolete",
  "olderNames": [
    "Xerocomus chrysenteron",
    "Boletus chrysenteron"
  ],
  "edibility": {
    "value": "edible-cooked",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "Edible if cooked thoroughly, but soft, soggy and bland, and it decays quickly.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Brownish to grey-yellow cap, 4–10 cm, that cracks with age to show a thin layer of red flesh under the skin.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Underneath: lemon-yellow pores turning olive, slowly bruising blue-green.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Yellow stem flushed with red fibres, like a stick of rhubarb; no ring.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In broadleaved and conifer woods, often with beech.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "On the ground in broadleaved and conifer woods, often with beech.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "seasonMonths": {
    "value": [
      8,
      9,
      10,
      11
