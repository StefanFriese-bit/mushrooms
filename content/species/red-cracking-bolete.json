  "topPoints": [
    {
      "value": "Brownish to grey-yellow cap, 4–10 cm, that cracks with age to show a thin layer of red flesh under the skin.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Underneath: lemon-yellow pores turning olive, slowly bruising blue-green.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Yellow stem flushed with red fibres, like a stick of rhubarb; no ring.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In broadleaved and conifer woods, often with beech.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "On the ground in broadleaved and conifer woods, often with beech.",
    "sources": [
      "fn",
      "wp"
    ]
  },
