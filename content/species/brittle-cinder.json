  "topPoints": [
    {
      "value": "Wavy-edged cushions or crusts at the base of broadleaved trees, grey with a white edge when young.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Old ones turn black and very brittle, like charred wood.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "On the roots and lower trunks of beech, lime and oak; infected trees can fall without warning.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Roots and lower trunks of living broadleaved trees — beech, lime, oak, maple — and on after they die.",
    "sources": [
      "fn",
      "wp"
    ]
  },
