      "fn",
      "wf"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Translucent white, slimy caps, 2–8 cm, like porcelain, often with an ochre flush in the centre.",
      "sources": [
        "fn",
        "wf",
        "wp",
        "wt"
      ]
    },
    {
      "value": "Gills white, broad and widely spaced.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "A thin, tough stem with a small ring.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "In clusters on beech — dead trunks and branches, and high up on living trees.",
      "sources": [
        "fn",
        "wf",
        "wt"
      ]
    }
  ],
  "habitat": {
    "value": "On beech: dead trunks, stumps and branches, and high up on living trees; often in large numbers.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
    "value": [
      8,
      9,
      10
    ],
    "sources": [
      "fn",
      "wf"
    ]
  },
