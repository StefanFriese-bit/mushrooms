{
  "slug": "velvet-shank",
  "inatId": 67594,
  "scientific": "Flammulina velutipes",
  "english": "Velvet Shank",
  "olderNames": [
    "Collybia velutipes"
  ],
  "edibility": {
    "value": "edible-cooked",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "Always cook it, and use only the caps (the stems are tough). Check that no stem has a ring — the deadly Funeral Bell has one.",
    "sources": [
      "fn",
      "wf",
      "wt"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Bright orange caps, darker in the centre and slimy when wet, in clusters on dead broadleaved wood.",
      "sources": [
        "fn",
        "wf",
        "wp",
        "wt"
      ]
    },
    {
      "value": "Stem velvety, pale at the top and dark brown to black lower down; no ring.",
      "sources": [
        "fn",
        "wf",
        "wt"
      ]
    },
    {
      "value": "Gills white to pale yellow; white spore print.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Fruits from late autumn to early spring, when few other mushrooms do.",
      "sources": [
        "fn",
        "wt"
      ]
    }
  ],
  "habitat": {
    "value": "Stumps and trunks of dead broadleaved trees — elm, beech and others — and sometimes sick living trees; in dense clusters and tiers.",
    "sources": [
      "fn",
      "wf",
      "wt"
    ]
  },
  "seasonMonths": {
    "value": [
      11,
      12,
      1,
      2,
      3
    ],
    "sources": [
      "fn",
      "wf",
      "wt"
    ]
  },
  "sporePrint": {
    "value": "White",
    "sources": [
      "fn",
      "wp",
      "wf"
    ]
  },
  "features": {
    "underside": {
      "value": "gills",
      "sources": [
