      ],
      "sources": [
        "fn",
        "wt"
      ]
    },
    "fleshChange": {
      "value": "Thin; yellowish in the cap, brown in the stem; no colour change when cut is described",
      "sources": [
        "wf",
        "wp"
      ]
    },
    "smell": {
      "value": "Not distinctive; pleasant",
      "sources": [
        "fn",
        "wp"
      ]
    }
  },
