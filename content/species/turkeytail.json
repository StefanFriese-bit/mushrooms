  "topPoints": [
    {
      "value": "Thin, leathery, fan-shaped brackets up to 10 cm, usually in overlapping tiers.",
      "sources": [
        "fn",
        "wp",
        "wt-bracket"
      ]
    },
    {
      "value": "Top banded in many colours — browns, greys, blues, greens — finely hairy, with a wavy cream edge.",
      "sources": [
        "fn",
        "wp",
        "wt-bracket"
      ]
    },
    {
      "value": "Underneath: white to cream, covered in tiny pores (not smooth).",
      "sources": [
        "fn",
        "wp",
        "wt-bracket"
      ]
    },
    {
      "value": "On dead and living wood of broadleaved trees, all year round.",
      "sources": [
        "fn",
        "wt-bracket"
      ]
    }
  ],
  "habitat": {
    "value": "Dead wood of broadleaved trees, fallen or standing, especially beech and oak; sometimes on living trees.",
    "sources": [
      "fn",
      "wt-bracket"
    ]
  },
