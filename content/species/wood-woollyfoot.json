{
  "slug": "wood-woollyfoot",
  "inatId": 1275360,
  "scientific": "Collybiopsis peronata",
  "english": "Wood Woollyfoot",
  "olderNames": [
    "Gymnopus peronatus",
    "Collybia peronata"
  ],
  "edibility": {
    "value": "poisonous",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "First Nature calls it poisonous; it tastes very hot and peppery. Wikipedia: inedible, and one study found it gives off hydrogen cyanide.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "A pinkish-cream to yellow-brown cap, 2–6 cm, often with a small central bump; it shrivels with age.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "The lower stem is covered in pale woolly hairs — the key feature.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Gills the colour of the cap, turning reddish-brown with age; white spore print.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In clumps in leaf and needle litter in woods.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Leaf and needle litter in broadleaved and conifer woods, hedgerows, and under bracken on heaths.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "seasonMonths": {
    "value": [
      5,
