  "topPoints": [
    {
      "value": "Dense clumps of small, thin caps, 1.5–5 cm, pinkish-buff to pale brown, drying almost white.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Very crowded, narrow cream gills.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Tough stems, reddish-brown below and frosted, with white down at the base; no ring.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In leaf litter in broadleaved woods, often over buried wood.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Leaf litter in broadleaved woods, often where dead wood is buried; occasionally conifer plantations.",
    "sources": [
      "fn",
