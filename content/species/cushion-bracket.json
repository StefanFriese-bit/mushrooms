        "fn",
        "wf"
      ]
    },
    {
      "value": "Underneath: grey-brown to cinnamon pores.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "On plum, damson, cherry, blackthorn and other Prunus trees.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
