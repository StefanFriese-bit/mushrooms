  "topPoints": [
    {
      "value": "Orange-brown to amber jelly, about 2.5 cm across, cone-shaped at first, then drooping.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "On dead willow twigs and branches, often at head height.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Shrinks to almost nothing when dry and swells again after rain.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Dead attached twigs and branches, nearly always willow; sometimes alder.",
    "sources": [
      "fn",
      "wp"
    ]
  },
