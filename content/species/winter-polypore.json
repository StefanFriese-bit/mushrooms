  "topPoints": [
    {
      "value": "A round, grey-brown to dark brown cap, 1.5–10 cm, dipped in the middle, on a short central stem.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Underneath: white to cream pores, running a little down the stem.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "On fallen branches of broadleaved trees, especially beech, from late autumn to spring.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Dead broadleaved wood, mostly fallen branches, especially beech.",
    "sources": [
      "fn",
      "wp"
    ]
  },
