{
  "slug": "white-dapperling",
  "inatId": 1558279,
  "scientific": "Leucocoprinus leucothites",
  "english": "White Dapperling",
  "olderNames": [
    "Leucoagaricus leucothites",
    "Lepiota naucina"
  ],
  "edibility": {
    "value": "edible-some-react",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "Many call it edible, but some say it is slightly poisonous (it may upset the stomach — Wikipedia), and it looks very like the deadly Destroying Angel: for experienced foragers only (Wild Food UK).",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "White cap, 4–9 cm, smooth and silky, becoming flushed cream or pinkish.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Crowded white gills, free of the stem, turning pale pink with age.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "A thin ring on the stem; the base is swollen, with no bag.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Bruises yellowish where handled.",
      "sources": [
        "wf",
        "wp"
      ]
    },
    {
      "value": "In pastures, gardens and parks — grassland, not woodland.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Grassland — permanent pastures, meadows, gardens and parks; sometimes open woodland.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
    "value": [
      8,
      9,
      10
    ],
    "sources": [
      "fn",
      "wf"
    ]
  },
  "sporePrint": {
    "value": "White to very pale pink",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
