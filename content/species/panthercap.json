  "scientific": "Amanita pantherina",
  "english": "Panthercap",
  "olderNames": [],
  "edibility": {
    "value": "poisonous",
    "sources": [
      "wf",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "More poisonous than the Fly Agaric (vomiting, diarrhoea, confusion); First Nature calls it deadly.",
    "sources": [
      "wp",
      "fn"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Cap brown to grey-brown, evenly dotted with pure white warts.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Flesh white, and it stays white when cut — it never blushes pink.",
      "sources": [
        "wf",
        "fn-bl",
        "wp-bl"
      ]
    },
    {
      "value": "A smooth ring with no grooves on top.",
      "sources": [
        "wf",
        "wp-bl"
      ]
    },
    {
      "value": "Stem base: a bulb with a rim, or one or two narrow hoop-like rings just above it.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills white, crowded and free of the stem.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Mostly under oak and beech.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Woodland, mostly broadleaved — especially under oak and beech.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
    "value": [
      7,
      8,
