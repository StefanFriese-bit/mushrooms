  "topPoints": [
    {
      "value": "Dark olive-brown to almost black cap, 4–20 cm, slimy when wet, often dirty-looking with debris.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Crowded cream gills that ooze a white milk when damaged; old milk stains them brown.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Stem the colour of the cap or paler; no ring.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Under birch, especially in damp woods.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Under birch, especially in damp woods; also with spruce and pine in mixed woodland.",
