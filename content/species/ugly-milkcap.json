{
  "slug": "ugly-milkcap",
  "inatId": 382886,
  "scientific": "Lactarius turpis",
  "english": "Ugly Milkcap",
  "olderNames": [
    "Lactarius necator",
    "Lactarius plumbeus"
  ],
  "edibility": {
    "value": "poisonous",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "It was once boiled and used as a spice in parts of northern Europe, but it contains a compound that may cause cancer (First Nature; Wikipedia: mutagenic, and boiling does not remove it all).",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Dark olive-brown to almost black cap, 4–20 cm, slimy when wet, often dirty-looking with debris.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Crowded cream gills that ooze a white milk when damaged; old milk stains them brown.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Stem the colour of the cap or paler; no ring.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Under birch, especially in damp woods.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Under birch, especially in damp woods; also with spruce and pine in mixed woodland.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "seasonMonths": {
    "value": [
      8,
      9,
      10,
      11
    ],
    "sources": [
      "fn"
    ]
  },
  "sporePrint": {
    "value": "Creamy white",
    "sources": [
