{
  "slug": "horse-mushroom",
  "inatId": 58699,
  "scientific": "Agaricus arvensis",
  "english": "Horse Mushroom",
  "olderNames": [
    "Psalliota arvensis"
  ],
  "edibility": {
    "value": "edible-cooked",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "It can take up heavy metals such as cadmium from polluted ground, so eat it only now and then.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Big white cap, 8–20 cm across, yellowing with age and where it is bruised.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Smells of aniseed or almond.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills whitish only when very young, then pale pink-grey, then chocolate brown.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Large double ring; under a closed cap it shows a cog-wheel pattern.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Cut stem base turns only slowly and slightly yellow — never bright chrome yellow.",
      "sources": [
        "fn",
        "wf",
        "wp-xan"
      ]
    },
    {
      "value": "No bag (volva) at the base of the stem.",
      "sources": [
        "wf",
        "fn-dc"
      ]
    }
  ],
  "habitat": {
    "value": "Grassland: meadows, pasture and verges, especially manured ground near stables; often in large rings, sometimes among nettles.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "seasonMonths": {
    "value": [
      7,
      8,
      9,
      10,
      11
    ],
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "sporePrint": {
    "value": "Dark purple-brown to chocolate brown",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
