  "topPoints": [
    {
      "value": "Ivory-white cap, 2–7.5 cm, waxy and slightly greasy, often with a small hump.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Gills thick, waxy and very widely spaced, running down the stem.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Slender white stem, often wavy or curved; no ring.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In old, unfertilised grassland, lawns and churchyards, in autumn.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Old, unfertilised grassland — pastures, lawns, churchyards, parkland — and sometimes woodland clearings.",
    "sources": [
      "fn",
      "wp"
    ]
  },
