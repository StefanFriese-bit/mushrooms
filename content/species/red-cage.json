  "topPoints": [
    {
      "value": "A bright red, hollow ball of spongy lattice, 5–20 cm tall, rising from a white egg.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Olive-brown slime on the inside of the lattice smells strongly of rotting meat.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In gardens and parks, on mulch and compost; rare in mainland Britain.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Gardens and parks, on bark mulch, compost and decaying plant matter; rare in mainland Britain, commoner in the Channel Islands.",
