  "topPoints": [
    {
      "value": "Slender, smoky grey-brown to pinkish or ochre-brown spindles, 2–12 cm tall, in dense clusters.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Unbranched and brittle, often wavy or flattened, tapering at the base.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In old grassland and in leaf litter at woodland edges.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "On the ground in old, unfertilised grassland and in leaf litter at woodland edges and clearings.",
