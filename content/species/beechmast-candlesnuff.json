  "topPoints": [
    {
      "value": "Thread-thin stalks, black at the base and white-tipped while young, later black all over.",
      "sources": [
        "fn",
        "ns"
      ]
    },
    {
      "value": "Growing from old beech-nut cases, often buried in the leaf litter.",
      "sources": [
        "fn",
        "ns"
      ]
    },
    {
      "value": "Ripe stalks are covered in tiny pimples.",
      "sources": [
        "fn",
        "ns"
      ]
    }
  ],
  "habitat": {
    "value": "On old beech-nut cases (beechmast) in the leaf litter under beech.",
    "sources": [
      "fn",
      "ns"
    ]
  },
