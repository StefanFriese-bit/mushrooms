  },
  "topPoints": [
    {
      "value": "Cap brain-like: twisted folds and lobes, not pits — orange-brown to dark reddish-brown.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Cut it open: several hollow chambers, not one clean hollow like a true morel.",
      "sources": [
        "fn",
        "wf",
        "fn-mo"
      ]
    },
    {
      "value": "Stem short, stout and whitish, furrowed towards the base.",
      "sources": [
        "wf",
        "wp"
      ]
    },
    {
      "value": "In spring, under pines on sandy soil.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Coniferous woods, mostly under pines on sandy soil; rare in lowland Britain.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "seasonMonths": {
