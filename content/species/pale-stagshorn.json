        "fn",
        "wp"
      ]
    },
    {
      "value": "In groups on well-rotted logs and stumps of conifers and broadleaved trees.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Greasy and slightly sticky.",
      "sources": [
