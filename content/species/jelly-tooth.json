  "topPoints": [
    {
      "value": "A translucent, greyish-white jelly cap, 2–7 cm, shaped like a tongue or fan.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Underneath: soft jelly teeth (spines), up to 3 mm long.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "On rotting conifer wood, especially spruce, in damp shade.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Dead and rotting conifer wood, especially spruce and pine, in damp, shady places.",
