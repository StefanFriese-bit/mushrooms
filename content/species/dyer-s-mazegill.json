  "topPoints": [
    {
      "value": "Large, flat, felty rosettes, 15–25 cm or more, rusty-brown with a bright yellow edge.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Underneath: greenish-yellow pores, turning reddish-brown.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "At the base of pines and spruces, on the roots — it can seem to grow from the ground.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "On the roots and at the base of conifers, especially pines and spruces; also their stumps.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
