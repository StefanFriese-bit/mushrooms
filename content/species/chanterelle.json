  "topPoints": [
    {
      "value": "Underneath: blunt, forked ridges running down the stem — not thin, blade-like gills.",
      "sources": [
        "fn",
        "wf",
        "wt"
      ]
    },
    {
      "value": "Egg-yolk yellow; the cap becomes a funnel with a wavy edge.",
      "sources": [
        "fn",
        "wf",
        "wt"
      ]
    },
    {
      "value": "Flesh white to pale inside.",
      "sources": [
        "wf",
        "fn-tub"
      ]
    },
    {
      "value": "Smells fruity, like apricots.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Stem solid and the same colour as the cap.",
      "sources": [
        "fn",
        "wf",
        "wt",
        "fn-tub"
      ]
    },
    {
      "value": "Grows from the ground in woodland.",
      "sources": [
        "fn",
        "wf",
        "wt"
      ]
    }
  ],
  "habitat": {
    "value": "Woodland — mostly broadleaved (oak, beech, birch, hazel) but also under conifers; often in moss, on acid soils.",
