  },
  "topPoints": [
    {
      "value": "A caramel to chestnut-brown cap, 1.5–5 cm, wavy at the edge when mature, drying pale buff.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "It bruises blue — the cap edge and the white stem.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Gills brown, turning purple-brown; very dark spore print.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "On woodchip mulch in flowerbeds and parks, in autumn and winter.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Woodchip mulch in flowerbeds, parks and gardens; probably introduced to Britain.",
