{
  "slug": "jack-o-lantern",
  "inatId": 126831,
  "scientific": "Omphalotus illudens",
  "english": "Jack O'Lantern",
  "olderNames": [
    "Clitocybe illudens"
  ],
  "edibility": {
    "value": "poisonous",
    "sources": [
      "fn",
      "wp",
      "wf-ch"
    ]
  },
  "edibilityNote": {
    "value": "Raw or cooked, it causes vomiting, cramps and diarrhoea that can last for several days.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Large bright orange caps, 7–20 cm, in dense clusters on wood — buried roots or stumps of broadleaved trees, especially oak.",
      "sources": [
        "fn",
        "wp",
        "wf-ch"
      ]
    },
    {
      "value": "True gills, orange like the cap, running down the stem — they do not fork.",
      "sources": [
        "fn",
        "wp",
        "wf-ch"
      ]
    },
    {
      "value": "Flesh orange right through — a Chanterelle's is white inside.",
      "sources": [
        "wp",
        "wf-ch"
      ]
    },
    {
      "value": "Creamy white spore print. Very rare in Britain.",
      "sources": [
        "fn",
        "wp",
        "wf-ch"
      ]
    }
  ],
  "habitat": {
    "value": "On buried roots of broadleaved trees — especially oak and sweet chestnut — often in lawns and parkland near trees; sometimes on stumps.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "seasonMonths": {
    "value": [
      7,
      8,
      9,
      10
    ],
    "sources": [
      "fn"
    ]
  },
