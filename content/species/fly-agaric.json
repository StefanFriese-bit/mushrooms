  "topPoints": [
    {
      "value": "Bright red (sometimes orange) cap, 8–20 cm, with white to yellowish warts that rain can wash off.",
      "sources": [
        "fn",
        "wf",
        "wp",
        "wt"
      ]
    },
    {
      "value": "Gills white, free and crowded; white spore print.",
      "sources": [
        "fn",
        "wf",
        "wp",
        "wt"
      ]
    },
    {
      "value": "White stem with a large hanging ring, and a swollen base ringed with the remains of its bag.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Under birch especially, also pines and spruces.",
      "sources": [
        "fn",
        "wf",
        "wt"
      ]
    }
  ],
  "habitat": {
    "value": "Under birch especially, and pines and spruces, in woods, heaths and parks.",
