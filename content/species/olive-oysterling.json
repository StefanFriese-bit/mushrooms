  "topPoints": [
    {
      "value": "Olive-green, kidney- or oyster-shaped caps, 3–10 cm, often tinged violet or brown, slimy when wet.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Crowded yellow to orange-yellow gills.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "A short, stout side stem, or none; in overlapping tiers on rotten wood.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In autumn and winter, after the cold sets in.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Rotten wood of broadleaved trees, sometimes conifers; alone or in overlapping tiers.",
    "sources": [
      "fn",
