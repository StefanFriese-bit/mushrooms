  "topPoints": [
    {
      "value": "Thin, felty, buff to grey-brown brackets 2–7 cm, often in overlapping tiers or spreading as a crust.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Underneath: smoke-grey pores, paler at the edge, blackening when damaged.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "On dead broadleaved wood, especially beech.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Dead broadleaved wood, especially beech; very rarely conifers.",
    "sources": [
      "fn",
      "wf"
    ]
  },
