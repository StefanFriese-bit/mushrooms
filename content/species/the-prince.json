{
  "slug": "the-prince",
  "inatId": 49547,
  "scientific": "Agaricus augustus",
  "english": "The Prince",
  "olderNames": [],
  "edibility": {
    "value": "edible-cooked",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "It builds up the metal cadmium: pick it away from towns and busy roads.",
    "sources": [
      "wf",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Large cap, 10–25 cm, with chestnut-brown scales on a white to cream background.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills free, pale pink at first, then dark chocolate brown.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "A large hanging ring; the stem is smooth above it and has small woolly scales below.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Smells strongly of bitter almonds. It may turn faintly yellow where touched, so the smell is the check.",
      "sources": [
        "fn",
        "wp",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Open woods and woodland edges, especially under conifers; also parks, gardens, lawns and roadsides.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
    "value": [
      7,
      8,
      9,
