  "topPoints": [
    {
      "value": "A tiny milk-white to pale beige cone-shaped cap, 1–3.5 cm, on a very thin, fragile white stem.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Gills pale ochre, soon rusty; rust-brown spore print.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "On lawns and short grass after rain; it collapses within a day.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Lawns, parks, playing fields and other short grass; sometimes woodchip and manured straw.",
    "sources": [
      "fn",
      "wp"
    ]
  },
