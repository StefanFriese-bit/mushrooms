  "topPoints": [
    {
      "value": "A hard, round ball with no stem, like a warty potato.",
      "sources": [
        "fn",
        "wf",
        "wt"
      ]
    },
    {
      "value": "Skin thick and tough, dirty yellow to ochre-brown, cracked into coarse scales.",
      "sources": [
        "fn",
        "wp",
        "wt"
      ]
    },
    {
      "value": "Cut open: purple-black inside with fine white veins — never pure white like a puffball.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Smells unpleasant, of gas or rubber.",
      "sources": [
        "fn",
        "wf",
        "wt"
      ]
    },
    {
      "value": "On sandy, peaty or mossy ground in woods and heaths, often by paths and ditches.",
      "sources": [
        "fn",
        "wf",
        "wt"
      ]
    }
  ],
  "habitat": {
    "value": "Woods and heaths on sandy, peaty or mossy soil; often on banks, by forest tracks and ditches.",
    "sources": [
