  "topPoints": [
    {
      "value": "Black, rubbery jelly in top-shaped blobs 1–2 cm across (up to 5), which can merge into masses up to 10 cm.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Shiny, dark brown to black; firmer than most jelly fungi.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Dries to a thin black crust, and swells again after rain.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "On dead branches of broadleaved trees, especially oak; also hazel and beech.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Dead attached and fallen branches of broadleaved trees, especially oak; also hazel, beech and alder.",
    "sources": [
      "fn",
      "wp"
    ]
  },
