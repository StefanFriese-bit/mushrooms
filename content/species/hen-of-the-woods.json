  "topPoints": [
    {
      "value": "A big rosette of many grey-brown, wavy-edged, spoon-shaped caps, 20 to 50 cm across.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Underneath each cap: small white pores — no gills.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "At the base of old oak trees.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "The Giant Polypore looks similar, but its fronds are thicker and browner and turn black where handled.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
