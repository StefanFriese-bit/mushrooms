  "topPoints": [
    {
      "value": "Greasy, buttery-feeling cap, 2–10 cm, reddish-brown to grey-brown, paler as it dries, with a darker hump.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills white to very pale cream, crowded; cream-buff spore print.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Stem widening towards a club-shaped base; no ring.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "In leaf litter and conifer needles, mainly under conifers.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Leaf litter and conifer needles in woods, mainly under conifers.",
    "sources": [
      "fn",
      "wf"
    ]
  },
