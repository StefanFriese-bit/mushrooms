{
  "slug": "bulbous-honey-fungus",
  "inatId": 118401,
  "scientific": "Armillaria gallica",
  "english": "Bulbous Honey Fungus",
  "olderNames": [
    "Armillaria bulbosa",
    "Armillaria lutea"
  ],
  "edibility": {
    "value": "edible-some-react",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "Cook it thoroughly (it is acrid raw) and try a small portion first: some people get an upset stomach (Wikipedia). First Nature adds that honey fungi on broadleaved trees are considered suspect by some, as poisonings have been linked to them.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Ochre-brown to red-brown cap, 4–10 cm, covered in fine brown scales, darker in the centre.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Gills whitish, turning yellowish-brown; white spore print.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "A cobweb-like ring that soon disappears; the stem swells towards the base.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In clusters, usually on the ground from buried roots and wood of broadleaved trees.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "On the ground from buried roots and rotting wood of broadleaved trees, sometimes on stumps; rarely under conifers.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "seasonMonths": {
    "value": [
      6,
      7,
      8,
      9,
      10,
      11
    ],
    "sources": [
      "fn"
    ]
  },
  "sporePrint": {
    "value": "White or very pale cream",
    "sources": [
      "fn",
      "wp"
    ]
  },
