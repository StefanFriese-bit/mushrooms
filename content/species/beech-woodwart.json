  "topPoints": [
    {
      "value": "Small round lumps, 2–9 mm across (up to 15 mm), crowded on dead beech wood.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Pinkish to brick-red when young, then rusty brown and finally black; the surface is pimply, like a strawberry.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Inside: hard and black.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "On fallen branches and rotting stumps, mostly beech; seen all year.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
