  "topPoints": [
    {
      "value": "White, brittle, worm-like spindles, 2–12 cm tall (up to 15), in dense clusters.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Unbranched, with pointed tips that may yellow with age.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In short, old grassland and in leaf litter at woodland edges.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
