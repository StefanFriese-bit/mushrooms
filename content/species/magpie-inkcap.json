  "topPoints": [
    {
      "value": "Cap dark brown to black, covered in white patches like a magpie's feathers.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Starts egg-shaped and white, then opens into a bell; the edge turns black and melts into ink.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills white, then pinkish, then black, melting into ink.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "In broadleaved woods, mostly under beech on chalky soil; usually alone or a few together.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Broadleaved woods, mostly under beech (less often oak), on chalky or limy soil; a rare find.",
    "sources": [
      "fn",
      "wf"
    ]
  },
