  "topPoints": [
    {
      "value": "Tawny orange-brown cap up to 10 cm, funnel-shaped with an inrolled, often wavy edge.",
      "sources": [
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills very crowded, paler than the cap, running far down the stem.",
      "sources": [
        "wf",
        "wp"
      ]
    },
    {
      "value": "In leaf litter and conifer needles, alone or in rings.",
      "sources": [
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
