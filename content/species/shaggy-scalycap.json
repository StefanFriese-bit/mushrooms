  "topPoints": [
    {
      "value": "Straw-yellow cap, 3–12 cm, covered in upturned brown scales.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Scaly stem below a ragged ring, smooth above it.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Gills pale yellow, turning cinnamon; rusty-brown spore print.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In clusters at the base of broadleaved trees and stumps, especially beech.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "In clusters at the base of living or dead broadleaved trees and stumps, especially beech; rarely conifers.",
    "sources": [
