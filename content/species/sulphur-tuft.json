{
  "slug": "sulphur-tuft",
  "inatId": 48767,
  "scientific": "Hypholoma fasciculare",
  "english": "Sulphur Tuft",
  "olderNames": [
    "Naematoloma fasciculare",
    "Nematoloma fasciculare",
    "Psilocybe fascicularis"
  ],
  "edibility": {
    "value": "poisonous",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "It has caused severe poisoning, probably including a death; the symptoms can start 5–10 hours after eating.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Tufts of sulphur-yellow caps, 2–8 cm, often tan in the centre.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills yellow at first, turning olive-green, then dark.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Purple-brown spore print; dark threads of veil often hang from the cap edge.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "In dense clusters on stumps and dead wood, all year round.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "In dense clusters on stumps, felled trunks and buried roots of broadleaved trees, less often conifers.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
    "value": [
