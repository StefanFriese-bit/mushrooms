{
  "slug": "yellow-stainer",
  "inatId": 118394,
  "scientific": "Agaricus xanthodermus",
  "english": "Yellow Stainer",
  "olderNames": [
    "Psalliota xanthoderma",
    "Agaricus velenovskyi"
  ],
  "edibility": {
    "value": "poisonous",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "Causes stomach cramps and other stomach upsets in many people, though a few eat it with no ill effect.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Cut the stem base: the flesh turns bright chrome yellow at once.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Scratch the cap: it turns yellow quickly, later fading to brown.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Smells of ink, iodine or carbolic soap — strongest at the cut base, and stronger still when cooked.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "White cap, often square-topped when young.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "A large hanging ring that lasts, and a bulbous stem base.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills white at first, then pink, then grey-brown to chocolate.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Hedgerows, the edges of parks and gardens, verges and other disturbed ground; also grassland and open woodland; often in groups or rings.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "seasonMonths": {
    "value": [
