  "topPoints": [
    {
      "value": "Small yellow to orange-yellow cap, greasy to the touch, with fine lines at the edge.",
      "sources": [
        "fn",
        "ns"
      ]
    },
    {
      "value": "Pale yellow gills, broadly attached and often running a little way down the stem.",
      "sources": [
        "fn",
        "ns"
      ]
    },
    {
      "value": "Thin yellow stem, dry rather than sticky.",
      "sources": [
        "fn",
        "ns"
      ]
    },
    {
      "value": "In short, old grassland such as lawns and churchyards.",
      "sources": [
        "fn",
        "ns"
      ]
    }
  ],
  "habitat": {
    "value": "Short, old grassland: lawns, churchyards and cemeteries.",
