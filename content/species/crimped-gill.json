  "topPoints": [
    {
      "value": "Small fan- or shell-shaped brackets, 1–3 cm, in groups on dead branches; the top is zoned and paler towards the edge.",
      "sources": [
        "wf",
        "wp"
      ]
    },
    {
      "value": "Underneath: white, wrinkled, crimped folds — not true gills.",
      "sources": [
        "wf",
        "wp"
      ]
    },
    {
      "value": "Usually on dead hazel in the UK; also beech, birch and alder.",
      "sources": [
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
