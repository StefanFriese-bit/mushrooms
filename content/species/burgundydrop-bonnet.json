  },
  "topPoints": [
    {
      "value": "Small pinkish-brown to reddish-brown bell-shaped caps, 2–4 cm, with a scalloped edge, often in tufts.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Break or cut the stem: it bleeds a dark red juice.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Whitish gills, turning pale pink.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "On rotting stumps, logs and fallen wood of broadleaved trees, especially oak and beech.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Rotting stumps, trunks and fallen wood of broadleaved trees, especially oak and beech, in damp shady places.",
    "sources": [
      "fn",
      "wp"
    ]
  },
