  ],
  "edibility": {
    "value": "edible-some-react",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "Cook it well. It upsets some people's stomachs and some react strongly to it; First Nature advises not eating it at all.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Large cap, 5–20 cm, with thick shaggy brown scales on a cream background.",
      "sources": [
        "fn",
        "wf",
        "wp",
        "wt"
      ]
    },
    {
      "value": "Cut it: the flesh and gills turn orange-red.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Stem plain — no snakeskin bands — with a very bulbous base and a thick double ring that slides.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "In woods, especially under conifers, and in shady gardens; often in troops or rings.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "All kinds of woodland, especially conifers, and shady places with rich, disturbed soil such as gardens; often in troops or rings.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
    "value": [
      7,
