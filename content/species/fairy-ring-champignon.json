    ]
  },
  "edibilityNote": {
    "value": "Deadly white funnels grow in the same grass, even in rings, from mid-summer. Check every one: gills well spaced and free of the stem, never running down it.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Small tan to buff cap, 2–5 cm, with a broad hump in the middle; it turns paler as it dries.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills well spaced, white to cream, free of the stem or barely touching it — never running down it.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Stem thin, tough and bendy; no ring.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "In rings or arcs in short grass: lawns, verges, parks and pasture.",
      "sources": [
        "wf",
        "wp",
        "fn"
      ]
    }
  ],
  "habitat": {
    "value": "Short grass on lawns, roadside verges, parks and pasture, usually in rings or arcs; occasionally at woodland edges.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
