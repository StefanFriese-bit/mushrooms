  "edibilityNote": {
    "value": "A good edible mushroom, but it upsets some people: eat only a little the first time. Several poisonous species look like it — its tight clusters are the key.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
