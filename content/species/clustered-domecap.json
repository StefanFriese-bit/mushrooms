    ]
  },
  "topPoints": [
    {
      "value": "Dense clusters of grey-brown caps, 4–10 cm, smooth and shiny, often misshapen.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Stems joined together at the base; no ring.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Crowded white to very pale grey gills; white spore print.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "From the ground, not wood — grassy woodland edges, paths, gravel drives.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "On disturbed soil rich in leaf litter — grassy woodland edges, paths, roadsides and gravel drives.",
    "sources": [
      "fn",
      "wf"
    ]
  },
