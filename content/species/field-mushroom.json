{
  "slug": "field-mushroom",
  "inatId": 143563,
  "scientific": "Agaricus campestris",
  "english": "Field Mushroom",
  "olderNames": [
    "Psalliota campestris"
  ],
  "edibility": {
    "value": "edible-cooked",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "Eat it cooked. Its deadly lookalikes, the Deathcap and the Destroying Angel, can be white when young, so check every point below.",
    "sources": [
      "fn",
      "wf",
      "wp",
      "fn-dc",
      "fn-da",
      "wt-poison"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "White cap, 3–10 cm across, rounded at first and opening out flat.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills pink from the start, turning dark chocolate brown.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Cut or scratched flesh stays white or turns slightly pink — never yellow.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "A single thin ring, often gone by the time the cap has opened.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "No bag (volva) at the base of the stem.",
      "sources": [
        "fn-dc",
        "wp"
      ]
    },
    {
      "value": "Grows in open grassland — pasture, parks and lawns — and rarely in woods.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Open grassland: pasture, meadows, parks, lawns and verges, alone, in groups or in fairy rings. Rarely in woodland.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "seasonMonths": {
    "value": [
      6,
      7,
      8,
      9,
      10
    ],
    "sources": [
      "fn",
      "wf"
    ]
  },
  "sporePrint": {
    "value": "Chocolate brown",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "features": {
