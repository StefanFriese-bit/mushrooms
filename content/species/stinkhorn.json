{
  "slug": "stinkhorn",
  "inatId": 54594,
  "scientific": "Phallus impudicus",
  "english": "Stinkhorn",
  "olderNames": [],
  "edibility": {
    "value": "edible-cooked",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "Only the young 'egg' is eaten; the grown fungus stinks. An egg can be mistaken for a deadly Amanita's egg or a poisonous earthball: cut it in half.",
    "sources": [
      "wf",
      "wp",
      "fn"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "A tall white spongy stem, 15–25 cm, topped by a honeycombed cap coated in olive-black slime.",
      "sources": [
        "fn",
        "wf",
        "wp",
        "wt"
      ]
    },
    {
      "value": "A strong, foul smell that carries a long way; flies eat the slime.",
      "sources": [
        "fn",
        "wf",
        "wt"
      ]
    },
    {
      "value": "It starts as a white 'egg', 4–8 cm across, half buried, full of jelly.",
      "sources": [
        "fn",
        "wp",
        "wf"
      ]
    },
    {
      "value": "Near rotting stumps and wood, in all kinds of woodland.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Woodland of all kinds, especially conifers, always near rotting wood.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
    "value": [
      6,
      7,
      8,
      9,
      10
    ],
    "sources": [
      "fn",
      "wf"
    ]
  },
  "sporePrint": {
    "value": "Pale yellow spores, held in the olive slime (no print can be made)",
    "sources": [
      "fn",
      "wf"
    ]
  },
