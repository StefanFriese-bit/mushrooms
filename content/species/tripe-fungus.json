  "topPoints": [
    {
      "value": "Rubbery, hairy brackets 3–7 cm, zoned in grey, brown and purple, often merging along fallen trunks.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Underneath: smooth at first, then wrinkled and veined, reddish-brown to purplish.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "On dead elm and beech especially.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Dead wood and stumps of broadleaved trees, especially elm and beech.",
