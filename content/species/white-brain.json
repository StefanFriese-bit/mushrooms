    {
      "value": "Clear to pure white jelly cushions, each up to 2 cm, merging into masses along dead branches.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Becomes folded like a brain with age; almost invisible once dried.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "On dead branches of broadleaved trees, especially beech and ash.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
