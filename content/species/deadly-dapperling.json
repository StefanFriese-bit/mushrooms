{
  "slug": "deadly-dapperling",
  "inatId": 515954,
  "scientific": "Lepiota brunneoincarnata",
  "english": "Deadly Dapperling",
  "olderNames": [
    "Lepiota patouillardi"
  ],
  "edibility": {
    "value": "deadly",
    "sources": [
      "fn",
      "wp",
      "wf-poison"
    ]
  },
  "edibilityNote": {
    "value": "Contains the same poison as the Deathcap. Small dapperlings are very hard to tell apart and several are deadly — never eat one.",
    "sources": [
      "fn",
      "wp",
      "wf-poison"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Small: cap 2.5–6 cm across.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Cap pinkish-brown, with darker scales in rough rings, darkest in the centre.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Stem pinkish above, with dark brown scales below a vague ring zone.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "White gills, free of the stem; white spore print.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Grows in grassy places, including gardens and dunes, and in broadleaved woods.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Rare in Britain.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Grassy places (gardens, dunes) and broadleaved or mixed woods; a rare find in Britain.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "seasonMonths": {
    "value": [
