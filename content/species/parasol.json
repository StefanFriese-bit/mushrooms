  },
  "edibilityNote": {
    "value": "Pick only large, opened caps: a cap under 10–12 cm across may be one of the small, deadly dapperlings, and young closed ones can look like deadly Amanitas.",
    "sources": [
      "fn",
      "wf",
      "wp",
      "fn-dd"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Very large: cap 10–25 cm across, on a tall stem of up to 30 cm or more.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "A brown snakeskin pattern of bands on the stem.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "A thick double ring that slides up and down the stem.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Cap pale with darker brown scales and a smooth, dark bump in the middle.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Flesh white, not reddening when cut.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "White gills, free of the stem.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Grassy places beside woods, woodland clearings, pasture and verges; alone, in groups or in rings.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
