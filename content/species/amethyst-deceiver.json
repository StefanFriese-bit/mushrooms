    ]
  },
  "edibilityNote": {
    "value": "It can build up arsenic from polluted ground. Faded, pale ones are easily confused with the deadly Lilac Fibrecap: pick only ones whose gills are purple too.",
    "sources": [
      "wp",
      "wf",
      "fn"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Small deep purple cap, 2–6 cm, that fades to buff or almost white as it dries.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills purple like the cap, thick and widely spaced; white spore print.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Stem purple, tough, fibrous and often twisted; no ring.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "In leaf litter and moss in woods, especially under beech and oak.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "In leaf litter and moss in all kinds of woodland, especially under beech and oak.",
    "sources": [
      "fn",
      "wf"
    ]
  },
