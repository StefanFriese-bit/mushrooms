  "topPoints": [
    {
      "value": "White to cream cap, 6–14 cm, that bruises and ages yellow-ochre.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills free, white or greyish-pink at first, then chocolate brown.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Smells of aniseed or almond.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "A drooping ring, and a small bulb at the stem base — no bag.",
      "sources": [
        "wf",
        "wp",
        "fn"
      ]
    }
  ],
