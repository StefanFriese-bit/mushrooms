  "topPoints": [
    {
      "value": "A white to cream, felty cap, 5–15 cm (up to 20), often breaking into grey-brown scales; usually off-centre.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "White gills running down the stem; white spore print.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "A short, thick stem with a short-lived ring.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "On dead broadleaved wood, or dead parts of living trees — beech, oak, horse chestnut.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Dead broadleaved wood and dead parts of living trees, especially beech, oak and horse chestnut.",
