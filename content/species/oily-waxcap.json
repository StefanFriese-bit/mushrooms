{
  "slug": "oily-waxcap",
  "inatId": 363620,
  "scientific": "Hygrocybe quieta",
  "english": "Oily Waxcap",
  "olderNames": [
    "Hygrocybe obrussea"
  ],
  "edibility": {
    "value": "not-edible",
    "sources": [
      "fn"
    ]
  },
  "edibilityNote": {
    "value": "Not known to be seriously toxic, but too insubstantial to eat — and waxcaps are scarce: it is listed as vulnerable worldwide.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Yellow to orange-yellow cap, 4–6 cm (up to 7.5), always rounded, never pointed.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Widely spaced gills, orange and paler than the cap.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "An oily, soapy smell, like shield bugs, when a gill is crushed.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In old, unfertilised grassland.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Old grassland, grazed or mown short and never fertilised — pastures and lawns, often on acid soil.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "seasonMonths": {
    "value": [
      8,
      9,
      10,
      11,
      12
    ],
