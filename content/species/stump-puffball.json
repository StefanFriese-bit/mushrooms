{
  "slug": "stump-puffball",
  "inatId": 972793,
  "scientific": "Apioperdon pyriforme",
  "english": "Stump Puffball",
  "olderNames": [
    "Morganella pyriformis",
    "Lycoperdon pyriforme"
  ],
  "edibility": {
    "value": "edible-cooked",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "Eat only young ones that are pure white right through. Cut each one top to bottom: a deadly Amanita button shows the outline of a cap and gills.",
    "sources": [
      "wf",
      "fn",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Pear-shaped puffballs, 1.5–4 cm across, in dense clusters on rotting wood.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Off-white to brown, covered at first in tiny warts.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "White and firm inside when young, turning yellow, then olive-brown and powdery.",
      "sources": [
        "wf",
        "fn"
      ]
    },
    {
      "value": "On stumps and buried roots — it can look as if it grows from soil.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "On rotting stumps and buried roots of trees, mostly broadleaved, in woods, pasture, commons and heaths.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
    "value": [
      7,
      8,
      9,
      10,
      11
    ],
    "sources": [
      "fn",
      "wf"
    ]
  },
  "sporePrint": {
    "value": "Olive-brown",
    "sources": [
      "wf",
      "fn"
    ]
  },
  "features": {
    "underside": {
      "value": "other",
      "sources": [
        "fn",
        "wp"
      ]
    },
    "ring": {
      "value": "no",
      "sources": [
        "fn",
        "wp"
      ]
    },
    "bagAtBase": {
      "value": "no",
