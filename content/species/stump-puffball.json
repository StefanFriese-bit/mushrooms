      ]
    },
    "capCm": {
      "value": [
        1.5,
        3
      ],
      "sources": [
        "fn",
        "wp"
      ]
    },
    "fleshChange": {
      "value": "White and firm when young; turns yellow, then olive-brown",
      "sources": [
        "wf",
        "fn"
      ]
    },
    "smell": {
      "value": "Unpleasant, like gas",
      "sources": [
        "fn"
      ]
    }
  },
