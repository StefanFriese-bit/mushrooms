  "topPoints": [
    {
      "value": "A grey-brown cap, 5–15 cm, streaked with radial fibres, often splitting at the edge.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Very broad, crowded white gills, turning cream.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Thick white cords run from the stem base into the wood — the key feature.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "On or near rotting broadleaved wood — stumps, logs, buried roots.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "On and near dead broadleaved wood — trunks, stumps, branches and buried roots; rarely conifers.",
    "sources": [
      "fn",
      "wf"
    ]
  },
