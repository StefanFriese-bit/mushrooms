  "topPoints": [
    {
      "value": "A thick, soft bracket 10–20 cm or more, rusty orange-brown and shaggy-hairy on top, blackening with age.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Underneath: yellowish pores, turning rusty brown, that weep droplets when young.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "On living ash, apple, oak and other broadleaved trees, including garden and orchard trees.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "On living or dying broadleaved trees — mostly ash and apple, also oak, poplar and others — often high on the trunk.",
    "sources": [
      "fn",
      "wf"
    ]
  },
