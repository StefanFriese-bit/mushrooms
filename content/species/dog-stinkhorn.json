{
  "slug": "dog-stinkhorn",
  "inatId": 63580,
  "scientific": "Mutinus caninus",
  "english": "Dog Stinkhorn",
  "olderNames": [],
  "edibility": {
    "value": "not-edible",
    "sources": [
      "wf",
      "wp",
      "fn"
    ]
  },
  "edibilityNote": {
    "value": "The young 'egg' is eaten in some countries, but none of these sites recommends it; dogs have been very sick after eating grown ones.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "A thin, spongy stem 8–15 cm tall, off-white to pale orange, often curved or sagging.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Its tip is coated in dark olive slime; once flies have eaten it, the tip shows orange.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "It grows from a small off-white 'egg', half buried in leaf litter; the split egg stays as a bag at the base.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Smells unpleasant, but much weaker than the common Stinkhorn.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In leaf litter near rotting stumps, often under conifers; also on old woodchip.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Leaf litter in woods, often under conifers and near rotting stumps; also on old woodchip mulch in parks and gardens.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
    "value": [
      7,
      8,
      9,
      10
    ],
    "sources": [
      "fn",
      "wf"
    ]
  },
  "sporePrint": {
    "value": "Pale yellow spores, held in a dark olive slime on the tip (Wikipedia: olive-brown)",
    "sources": [
      "fn",
      "wp"
    ]
  },
