  "topPoints": [
    {
      "value": "A small bolete with a velvety scarlet to raspberry-red cap, 3–8 cm, fading olive-red, often with a yellow edge.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Underneath: lemon-yellow pores, greenish with age, slowly bruising blue.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Stem yellow at the top, increasingly red below.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Under oak and beech, often in parks, gardens and grassy woods.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Rich soil under oak and beech, often in parks, gardens and grassy woodland.",
    "sources": [
      "fn",
      "wf"
    ]
  },
