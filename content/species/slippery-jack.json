  "topPoints": [
    {
      "value": "Cap chestnut to dark brown, very slimy when wet.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Underneath: lemon-yellow pores — no gills.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "A large, floppy ring on the stem, white at first, turning purplish underneath — unusual for a bolete.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Stem pale yellow, with brown dots above the ring.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Only under pine, often beside paths in pine woods and plantations.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Under pines, especially in plantations, often beside paths.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
    "value": [
