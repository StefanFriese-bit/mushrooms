  "topPoints": [
    {
      "value": "A thin, hard crust on hazel and willow twigs, greyish-brown with a lilac tint.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "It glues together twigs and branches that touch — the key feature.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Its surface is uneven, wavy or warty.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Living and dead twigs and branches of hazel and willow; occasionally other broadleaved trees.",
    "sources": [
      "fn",
      "wp"
    ]
  },
