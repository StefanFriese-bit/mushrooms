    {
      "value": "Four to six bright red, tentacle-like arms bursting from a white egg 2–4 cm across.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "The arms carry patches of dark olive slime that smell of rotting meat.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "In leaf litter, mulch and woodchip, in parks and gardens; rare, mostly in the south.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
