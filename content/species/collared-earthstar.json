  "topPoints": [
    {
      "value": "A round, greyish-brown spore sac sitting in a saucer-like collar, on a star of thick, fleshy rays.",
      "sources": [
        "wf",
        "wp"
      ]
    },
    {
      "value": "Brown spores puff out of a raised, pointed opening at the top of the sac.",
      "sources": [
        "wf",
        "wp"
      ]
    },
    {
      "value": "In leaf litter under broadleaved and conifer trees, often in groups.",
      "sources": [
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Rich soil and leaf litter under broadleaved and conifer trees, often on slopes; usually in groups.",
    "sources": [
      "wf",
