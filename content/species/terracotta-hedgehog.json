  "topPoints": [
    {
      "value": "Underneath: soft, pale spines hanging down like stalactites — no gills or pores.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Cap orange-red to terracotta, 2 to 6 cm across, often off-centre on the stem.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "The spines stop short of the stem — on the paler Wood Hedgehog they run down it.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Flesh whitish with pink tones, firm.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "On the ground among moss and leaf litter, mostly under conifers, also under broadleaved trees; often in rings or arcs.",
    "sources": [
      "fn",
      "wf"
    ]
  },
