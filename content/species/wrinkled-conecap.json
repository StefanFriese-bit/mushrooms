{
  "slug": "wrinkled-conecap",
  "inatId": 877494,
  "scientific": "Pholiotina rugosa",
  "english": "Wrinkled Conecap",
  "olderNames": [
    "Conocybe rugosa",
    "Conocybe filaris"
  ],
  "edibility": {
    "value": "deadly",
    "sources": [
      "wp",
      "wf-poison"
    ]
  },
  "edibilityNote": {
    "value": "Contains amatoxins (alpha-amanitin), the Deathcap's poison, which destroys the liver.",
    "sources": [
      "wp",
      "wf-poison"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Small tawny to caramel-brown cap, 1–3 cm, conical then bell-shaped, fading to buff when dry.",
      "sources": [
        "fn",
        "wf-poison",
        "wp"
      ]
    },
    {
      "value": "A clear white ring on a thin, fragile stem; the ring is often dusted rusty brown with spores.",
      "sources": [
        "fn",
        "wf-poison",
        "wp"
      ]
    },
    {
      "value": "Gills pale buff turning rusty brown; rusty-brown spore print.",
      "sources": [
        "fn",
        "wf-poison",
        "wp"
      ]
    },
    {
      "value": "On woodchip, compost, sawdust and leaf litter — often in gardens and flowerbeds.",
      "sources": [
        "fn",
        "wf-poison",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "On woodchip mulch, garden compost, sawdust, flowerbeds and leaf litter; also mossy woodland floors.",
    "sources": [
      "fn",
      "wf-poison",
      "wp"
    ]
  },
  "seasonMonths": {
    "value": [
      7,
      8,
      9,
      10
    ],
