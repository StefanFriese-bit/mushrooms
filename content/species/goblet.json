    ]
  },
  "edibilityNote": {
    "value": "Edible when thoroughly cooked, but it upsets a small number of people: try a little first (Wild Food UK). Take great care not to gather poisonous funnels such as the deadly Fool’s Funnel (First Nature).",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "A dark grey-brown, deeply funnel-shaped cap, 4–8 cm, with an inrolled edge; it fades with age.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills running down the stem, pale grey to beige — and forked, the key feature.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "A long, grey, fibrous stem; no ring.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "In woodland, on soil or rotten stumps; also pastures. Late in the year.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Mixed woodland, on soil or well-rotted stumps; also pastures and fields.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
    "value": [
      10,
      11,
      12
    ],
