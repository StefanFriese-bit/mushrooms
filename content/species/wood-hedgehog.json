  "topPoints": [
    {
      "value": "Underneath: soft spines hanging down like stalactites — no gills or pores.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Cap creamy white to pale buff or salmon, lumpy and uneven, finely velvety.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "The spines run a little way down the stem.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Stem white, short and stout, often off-centre.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Often in rings, in woods of every kind.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "On the ground among moss and leaf litter in broadleaved and coniferous woods; often in rings.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
