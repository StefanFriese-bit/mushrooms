{
  "slug": "lurid-bolete",
  "inatId": 824777,
  "scientific": "Suillellus luridus",
  "english": "Lurid Bolete",
  "olderNames": [
    "Boletus luridus"
  ],
  "edibility": {
    "value": "edible-cooked",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "Only after thorough cooking, and only when you are certain: poisonous red-pored boletes such as the Devil's Bolete look very like it. Wikipedia adds that raw or undercooked it upsets the stomach, and that it is suspected of a reaction with alcohol.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Cap 8–14 cm, sometimes up to 20: velvety pale yellow when young, then yellow-brown to olive-brown.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Underneath: yellow pores that soon turn orange-red; they bruise dark blue to black.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Yellow stem covered in a red net (mesh), except at the very top.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Cut it in half: the flesh turns blue-black at once, usually with a wine-red line just above the pores.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "On the ground under beech and oak, mostly on chalky soil.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "On the ground in broadleaved woods, mostly under beech and oak on chalky soil.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "seasonMonths": {
