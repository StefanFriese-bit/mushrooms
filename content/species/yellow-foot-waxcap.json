  },
  "edibilityNote": {
    "value": "Wild Food UK lists it as edible but not choice, and leaves waxcaps alone as their grasslands decline; First Nature: not one to collect. It is vulnerable worldwide (Wikipedia).",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
