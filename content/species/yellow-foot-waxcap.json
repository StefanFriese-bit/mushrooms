    ]
  },
  "topPoints": [
    {
      "value": "A grey to grey-brown cap, 1–4 cm, greasy when wet, often with a broad low bump.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Widely spaced grey gills, running down the stem, with veins between them.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "A pale stem that turns yellow at the base — the key feature.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "In old, unfertilised grassland — lawns, churchyards, moors.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Old, unfertilised grassland — lawns, churchyards and acid moorland.",
    "sources": [
      "fn",
      "wf"
    ]
  },
