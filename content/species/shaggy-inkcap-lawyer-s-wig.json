  "edibilityNote": {
    "value": "Pick only young ones with white gills and cook them the same day: once the gills blacken they melt into ink and turn bitter.",
    "sources": [
      "fn",
      "wp",
      "wf"
    ]
  },
  "protectedInUk": {
    "value": false,
