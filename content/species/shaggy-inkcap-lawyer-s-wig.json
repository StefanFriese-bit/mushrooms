  },
  "topPoints": [
    {
      "value": "Tall white cap shaped like an egg or a lawyer's wig, covered in shaggy white to pale brown scales.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills white, then pink, then black — they melt into black ink from the cap's edge.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "A thin loose ring that slips down the stem and often falls off.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "In groups on grass verges, lawns, path edges and disturbed ground.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Grass verges, lawns, path edges, grassland and freshly disturbed soil; often in groups or lines.",
    "sources": [
      "fn",
      "wf"
    ]
  },
