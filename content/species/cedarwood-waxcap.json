  "topPoints": [
    {
      "value": "A small ivory-white to cream cap, 0.5–3 cm, slightly sticky, translucent when wet.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "A strong smell of cedarwood, sandalwood or leather — the key feature.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "White gills, widely spaced, running down the stem.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "In short, mossy, unfertilised grassland — lawns, churchyards, dunes.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Short, mossy, unfertilised grassland — lawns, parks, churchyards, pastures and coastal dunes.",
    "sources": [
      "fn",
      "wf"
    ]
  },
