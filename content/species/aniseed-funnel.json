{
  "slug": "aniseed-funnel",
  "inatId": 1525546,
  "scientific": "Collybia odora",
  "english": "Aniseed Funnel",
  "olderNames": [
    "Clitocybe odora"
  ],
  "edibility": {
    "value": "edible-cooked",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "Good to eat, often dried as a flavouring. Young and pale ones are easily confused with poisonous species — the Fragrant Funnel smells of aniseed too — so check every feature, not the smell alone.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "A blue-green cap, 3–8 cm, fading to grey or cream with age; later funnel-shaped with a wavy edge.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "A strong smell of aniseed.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Pale gills running slightly down the stem; white spore print.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Stem with fine white down at the base; no ring.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "In leaf litter, mostly under beech.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "On the ground in broadleaved leaf litter, mostly under beech; occasionally under conifers; also parkland and heaths.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
    "value": [
      7,
      8,
      9,
      10
    ],
    "sources": [
      "fn",
      "wf"
    ]
  },
  "sporePrint": {
    "value": "White to faintly pink",
    "sources": [
      "fn",
      "wp"
    ]
  },
