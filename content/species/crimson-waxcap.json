{
  "slug": "crimson-waxcap",
  "inatId": 51869,
  "scientific": "Hygrocybe punicea",
  "english": "Crimson Waxcap",
  "olderNames": [
    "Hygrophorus puniceus"
  ],
  "edibility": {
    "value": "poisonous",
    "sources": [
      "wp",
      "fn"
    ]
  },
  "edibilityNote": {
    "value": "Some guides call it edible, but First Nature reports people in the USA with very unpleasant stomach upsets after eating it, and Wikipedia says the cadmium it builds up causes poisoning. It is also a threatened species of declining grasslands.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "A large waxcap: blood-red cap 3–10 cm (up to 15), greasy when wet, fading to yellowish buff in patches.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Waxy gills, yellow at first, turning red with age.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Thick stem streaked with fibres, yellow to red above, white at the base; no ring.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In old grassland that has never been fertilised — lawns, pasture, churchyards.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Old grassland, grazed or mown short and never fertilised — lawns, pasture, churchyards.",
    "sources": [
      "fn",
      "wp"
    ]
  },
