    {
      "value": "A tough, rubbery coral, 4–10 cm tall, with many slender, upright, parallel branches ending in sharp tips.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Pale cream to buff or yellow-brown, bruising reddish-brown.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "A faint smell of aniseed when mature.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "On stumps, logs and buried wood, often under beech; also on woodchip in flowerbeds.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
