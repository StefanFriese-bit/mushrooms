  "topPoints": [
    {
      "value": "A small bell-shaped cap, 1–2 cm, white at the edge and yellowish in the centre, lined almost to the middle.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "White gills, fairly widely spaced, turning cream.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "A thin, brittle, whitish stem with white fibres at the base.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In mossy lawns and old grassland, and grassy woodland edges.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Mossy lawns, old grassland and dune slacks; grassy woodland edges and clearings; sometimes under conifers.",
    "sources": [
      "fn",
      "wp"
    ]
  },
