  "topPoints": [
    {
      "value": "A slimy pink to lilac or violet-purple cap, 2–6 cm, with a broad bump in the centre.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Widely spaced pink gills with cross-veins; the gills are not slimy.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "A pale, slimy stem, white to pinkish, often orange-tinged.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Late in the year, in old unfertilised grassland.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
