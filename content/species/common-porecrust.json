  "topPoints": [
    {
      "value": "Small fan-shaped brackets, 1–4 cm across, white to grey and hairy on top, often in tiers.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Underneath: pinkish-grey 'gills' that are split down the middle — hence its other name, Split Gill.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "On damaged bark and dead branches; seen all year.",
