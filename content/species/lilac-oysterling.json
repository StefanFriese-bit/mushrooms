  },
  "topPoints": [
    {
      "value": "Oyster- or shell-shaped caps, 3–17 cm, lilac to reddish-purple-brown when young, fading to tan.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Crowded, forking gills running down a short, off-centre stem; pale lilac when fresh.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "In clusters on fallen trunks and stumps of broadleaved trees.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Dead broadleaved wood — fallen trunks, stumps and large branches of oak, birch, beech and ash; rarely conifers.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "seasonMonths": {
    "value": [
