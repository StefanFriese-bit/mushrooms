  "edibilityNote": {
    "value": "Not generally eaten in Europe (it is listed as edible in China); tough and possibly bitter.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
