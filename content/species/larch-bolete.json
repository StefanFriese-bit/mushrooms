    ]
  },
  "edibilityNote": {
    "value": "Peel off the slimy cap skin (the tubes are usually removed too) and cook it.",
    "sources": [
      "fn",
      "wp",
      "wf"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Slimy, bright yellow to rusty-orange cap, 4–12 cm, shiny even when dry.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Underneath: lemon-yellow pores that bruise rusty brown.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "A ring or ring zone on the stem, left by the veil that covered the young pores.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Only under larch.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Only under larch trees.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "seasonMonths": {
