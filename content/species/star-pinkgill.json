  "topPoints": [
    {
      "value": "A small brown cap, 1.5–6 cm, bell-shaped then flatter, much paler when dry; lined at the edge when wet.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Gills white, turning pink; pink spore print.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "A slender stem the colour of the cap, streaked lengthways; no ring.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In old, unfertilised grassland — lawns, parks, pastures.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Old, unfertilised grassland — lawns, parks, golf courses, dunes and pastures; sometimes grassy woodland clearings.",
    "sources": [
