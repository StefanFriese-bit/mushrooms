  },
  "edibilityNote": {
    "value": "Some guides call it edible and others poisonous; First Nature recommends treating it as a toxic toadstool, as some of its relatives are poisonous. It grows on dung.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
