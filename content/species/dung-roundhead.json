      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "A small, sticky, pale yellow to buff cap, 1–4 cm, shaped like half a ball.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Grey gills turning dark purple-brown; dark purple-brown spore print.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "A tall, thin stem, 5–12 cm, with a fragile ring that soon darkens or disappears.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "On dung and freshly manured grass.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "On animal dung, manured soil, lawns and grazed grassland.",
    "sources": [
      "fn",
      "wp"
    ]
  },
