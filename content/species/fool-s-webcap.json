{
  "slug": "fool-s-webcap",
  "inatId": 337849,
  "scientific": "Cortinarius orellanus",
  "english": "Fool's Webcap",
  "olderNames": [],
  "edibility": {
    "value": "deadly",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "Contains orellanine, which destroys the kidneys and damages the liver; people have died. Do not taste even a small piece.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Tawny to reddish-orange cap, 3–8 cm, dry and finely scaly, with a slight hump.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Gills well spaced, yellowish at first, then rusty red-brown; rusty spore print.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Stem paler than the cap and fibrous — without the yellow zig-zag bands of the Deadly Webcap.",
      "sources": [
        "fn",
        "wf-dw"
      ]
    },
    {
      "value": "Under oak, beech and other broadleaved trees, sometimes near pines; late summer to autumn.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Under oak, beech, hornbeam and other broadleaved trees, sometimes near conifers, on chalky or acid soil.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "seasonMonths": {
