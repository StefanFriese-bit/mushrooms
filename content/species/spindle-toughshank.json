  "topPoints": [
    {
      "value": "Red-brown to rusty cap, 3–7 cm, often with darker spots.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "A tough, spindle-shaped, grooved stem tapering to a long root; no ring.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Gills cream, widely spaced, developing rusty spots.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "In clusters at the roots of oak, sometimes beech.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "In clusters at the base of oaks, sometimes beech, on their roots and stumps.",
    "sources": [
      "fn",
      "wf"
    ]
  },
