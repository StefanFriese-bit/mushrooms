  "topPoints": [
    {
      "value": "A flat, waxy crust on dead wood, up to 10 cm across, often merging into patches up to 30 cm.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Pink to bright orange, with lumpy wrinkles radiating from the centre like veins; the edge is paler.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "On dead broadleaved trunks and fallen branches, especially oak; sometimes conifers.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Dead trunks and fallen branches of broadleaved trees, especially oak; sometimes conifer wood.",
    "sources": [
      "fn",
