  ],
  "edibility": {
    "value": "not-edible",
    "sources": [
      "fn"
    ]
  },
  "edibilityNote": {
    "value": "Generally regarded as inedible; small and thin-fleshed.",
    "sources": [
      "fn"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Conical or bell-shaped cap, shiny red-brown when wet, drying much paler.",
      "sources": [
        "fn",
        "ns"
      ]
    },
    {
      "value": "A very long, thin, white stem for the size of the cap, and brittle.",
      "sources": [
        "fn",
        "ns"
      ]
    },
    {
      "value": "Gills brown with a pale edge, darkening with age.",
      "sources": [
        "fn",
        "ns"
      ]
    },
    {
      "value": "Very dark brown spore print.",
      "sources": [
        "fn",
        "ns"
      ]
    }
  ],
  "habitat": {
    "value": "Under broadleaved trees in woods, copses, parks and gardens, among leaf litter and woody debris.",
    "sources": [
      "fn",
      "ns"
    ]
  },
  "seasonMonths": {
    "value": [
      6,
      7,
      8,
      9,
      10,
      11
    ],
    "sources": [
      "fn"
    ]
  },
  "sporePrint": {
    "value": "Very dark brown, almost black",
    "sources": [
      "fn",
      "ns"
    ]
  },
