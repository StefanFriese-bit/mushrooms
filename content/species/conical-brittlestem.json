{
  "slug": "conical-brittlestem",
  "inatId": 830766,
  "scientific": "Parasola conopilea",
  "english": "Conical Brittlestem",
  "olderNames": [
    "Parasola conopilus",
    "Psathyrella conopilus",
    "Psathyrella conopila",
