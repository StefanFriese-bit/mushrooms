{
  "slug": "giant-polypore",
  "inatId": 157989,
  "scientific": "Meripilus giganteus",
  "english": "Giant Polypore",
  "olderNames": [
    "Polyporus giganteus"
  ],
  "edibility": {
    "value": "edible-some-react",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "Only young ones, cooked slowly, are eaten, and it upsets some people; First Nature advises leaving it alone.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "A huge rosette of overlapping tan to brown fan-shaped caps, often 50 cm or more across, at the base of a tree or stump.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Underneath: white pores that bruise dark brown to black.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Mostly on beech, sometimes from buried roots a few metres from the trunk.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "At the base of beech, less often oak and other broadleaved trees, and on stumps; sometimes from buried roots away from the trunk.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "seasonMonths": {
    "value": [
      9
    ],
    "sources": [
      "fn",
      "wp"
    ]
  },
  "sporePrint": {
