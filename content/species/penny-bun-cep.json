{
  "slug": "penny-bun-cep",
  "inatId": 48701,
  "scientific": "Boletus edulis",
  "english": "Penny Bun / Cep",
  "olderNames": [],
  "edibility": {
    "value": "edible-cooked",
    "sources": [
      "fn",
      "wf",
      "wp",
      "wt"
    ]
  },
  "edibilityNote": {
    "value": "Pick young, firm ones: older ones are often full of maggots.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Underneath: a sponge of fine pores, white when young, then yellow and olive-green — no gills.",
      "sources": [
        "fn",
        "wf",
        "wp",
        "wt"
      ]
    },
    {
      "value": "Cap brown like a well-baked bread roll, often with a paler or white edge.",
      "sources": [
        "fn",
        "wf",
        "wp",
        "wt"
      ]
    },
    {
      "value": "Stem stout and swollen, pale, with a fine white net pattern, clearest near the top.",
      "sources": [
        "fn",
        "wf",
        "wp",
        "wt"
      ]
    },
    {
      "value": "Flesh white; it does not turn blue when cut or bruised.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "The Bitter Bolete looks similar: a darker net on its stem, pinkish pores, and a very bitter taste.",
      "sources": [
        "fn",
        "wf",
        "wp",
        "wt"
      ]
    },
    {
      "value": "On the ground under trees — beech, oak, birch and conifers.",
      "sources": [
        "fn",
        "wf",
        "wt"
      ]
    }
  ],
  "habitat": {
    "value": "Woodland — on the ground under beech, oak, birch, pine and spruce; often at wood edges and in grassy clearings.",
    "sources": [
      "fn",
      "wf",
      "wt"
    ]
  },
  "seasonMonths": {
    "value": [
      8,
