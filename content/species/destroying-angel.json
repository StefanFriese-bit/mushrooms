      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Pure white all over: cap, gills, stem and ring.",
      "sources": [
        "fn",
        "wf",
        "wp",
        "wt-poison"
      ]
    },
    {
      "value": "Gills stay white — they never turn pink or brown.",
      "sources": [
        "fn",
        "wf",
        "wt-poison"
      ]
    },
    {
      "value": "The stem rises from a bag (volva), often buried deep — dig out the whole base to see it.",
      "sources": [
        "fn",
        "wf",
        "wp",
        "wf-poison"
      ]
    },
    {
      "value": "A thin, fragile ring high on the stem, often torn or missing.",
      "sources": [
        "fn",
        "wf",
        "wf-poison"
      ]
    },
    {
      "value": "Young ones look like a white button mushroom from the shop.",
      "sources": [
        "fn",
        "wt-poison"
      ]
    },
    {
      "value": "White spore print.",
      "sources": [
        "fn",
        "wf",
        "wp",
        "wf-poison"
      ]
    }
  ],
  "habitat": {
    "value": "Broadleaved and mixed woodland — beech, birch, chestnut — often at the edge of the wood; prefers acid soil.",
    "sources": [
      "fn",
      "wf",
      "wp",
      "wt-poison",
      "wf-poison"
    ]
  },
