      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "A huge white ball, often 20 to 35 cm across — like a football lying in the grass.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "No gills and no real stem; the skin is smooth or finely velvety.",
      "sources": [
        "wf",
        "wp"
      ]
    },
    {
      "value": "Cut it in half: a young one is pure white and firm all through.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "In grass and rough ground — field edges, roadsides, among nettles and brambles, and at wood edges.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Fields, pasture, roadside verges, field edges among nettles and brambles; sometimes open woodland.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
