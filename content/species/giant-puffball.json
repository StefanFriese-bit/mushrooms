  "edibilityNote": {
    "value": "Only while it is fresh and pure white all through; once the inside turns yellowish, olive or brown it is past eating.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
