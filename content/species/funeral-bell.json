{
  "slug": "funeral-bell",
  "inatId": 154735,
  "scientific": "Galerina marginata",
  "english": "Funeral Bell",
  "olderNames": [
    "Galerina unicolor",
    "Agaricus marginatus",
    "Galerina autumnalis",
    "Pholiota marginata"
  ],
  "edibility": {
    "value": "deadly",
    "sources": [
      "fn",
      "wp",
      "wf"
    ]
  },
  "edibilityNote": {
    "value": "Contains the same deadly toxins as the Deathcap (amatoxins): sickness, then liver damage that can kill.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Small honey-yellow to rusty-brown caps, 1–7 cm, darker in the centre; the cap dries paler from the edge inwards.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "A small fragile ring, which can fall away; silvery fibres on the stem below it.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills pale tan turning rusty brown; rusty-brown (snuff) spore print.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "On rotting wood — mostly conifer stumps, also broadleaved wood and woodchip — alone or in small clusters.",
      "sources": [
        "fn",
        "wf",
        "wf-sw"
      ]
    }
  ],
  "habitat": {
    "value": "Stumps, dead trunks and fallen branches, mostly of conifers but also of broadleaved trees; also woodchip.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
    "value": [
