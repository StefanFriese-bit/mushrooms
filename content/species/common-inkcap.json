  },
  "topPoints": [
    {
      "value": "Grey to grey-brown bell-shaped cap, 3–10 cm, smooth or finely furrowed, melting into black ink from the edge.",
      "sources": [
        "fn",
        "wf",
        "wp",
        "wt"
      ]
    },
    {
      "value": "Gills white, then black, melting into ink.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "In tufts from buried wood: by stumps and paths, in parks and on verges.",
      "sources": [
        "fn",
        "wf",
        "wt"
      ]
    }
  ],
  "habitat": {
    "value": "In tufts from buried wood — beside stumps and paths, at the foot of trees in parks and gardens, on grassy verges.",
    "sources": [
