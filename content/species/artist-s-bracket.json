  "topPoints": [
    {
      "value": "A large, flat, hard bracket, 3–50 cm, brown and lumpy on top, with a thin white edge while growing.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Underneath: creamy-white pores that turn brown when scratched — people draw on them, hence the name.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "On dying and dead broadleaved trunks and stumps, especially beech and oak.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Dying and dead standing or fallen trunks and stumps of broadleaved trees, especially beech and oak; rarely conifers.",
    "sources": [
      "fn",
      "wf"
    ]
  },
