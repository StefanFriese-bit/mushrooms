  "topPoints": [
    {
      "value": "Clear to whitish jelly blobs, up to 1–2 cm, often merging into brain-like patches up to 6 cm.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Small hard white grains inside, like frog spawn with white 'eggs'.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "On dead branches of broadleaved trees, especially sycamore, beech and ash.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
