  "topPoints": [
    {
      "value": "Thin, fragile cap, 1.5–8 cm, honey-brown when young, quickly fading to whitish, often with white veil fragments on the edge.",
      "sources": [
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills white, then grey-lilac, then dark brown; purple-brown spore print.",
      "sources": [
        "wf",
        "wp"
      ]
    },
    {
      "value": "Very fragile, hollow white stem.",
      "sources": [
        "wf",
        "wp"
      ]
    },
    {
      "value": "In small groups on soil, wood and grass debris in woods, parks and gardens.",
      "sources": [
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "In small groups on soil, buried wood and grass debris in woods, parks, gardens and lawns.",
    "sources": [
      "wf",
      "wp"
    ]
  },
