  "topPoints": [
    {
      "value": "Smooth, pale buff to grey-brown cap, up to 12–15 cm, with an inrolled edge.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "A short, stout stem streaked with violet-blue fibres; no ring.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Gills white to pinkish-buff, crowded; pale pinkish-buff spore print.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "In grassland and pasture, especially on chalk, often in rings — late in the year.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Grassland and pasture, especially on chalk or limestone, often in rings; sometimes woods on limy soil.",
    "sources": [
      "fn",
      "wf"
    ]
  },
