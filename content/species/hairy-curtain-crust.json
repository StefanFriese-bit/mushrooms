  "topPoints": [
    {
      "value": "Thin, wavy-edged brackets 1–8 cm, hairy on top, yellow to orange-brown, often in overlapping tiers.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Underneath: smooth — no pores or gills — bright yellow to orange, fading with age.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "On dead broadleaved wood, especially oak and beech, all year round.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Dead trunks and fallen branches of broadleaved trees, especially oak and beech; rarely conifers.",
    "sources": [
      "fn",
