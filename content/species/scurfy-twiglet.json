  "topPoints": [
    {
      "value": "Small brown cap, 1–4 cm, finely hairy, its edge fringed with white veil scraps; it dries creamy ochre.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Gills the colour of the cap, fairly widely spaced; pale rusty-brown spore print.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In troops on twigs, woody debris and woodchip mulch.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "On twigs and other woody debris, and on woodchip mulch in parks and gardens; usually in troops.",
    "sources": [
      "fn",
      "wp"
    ]
  },
