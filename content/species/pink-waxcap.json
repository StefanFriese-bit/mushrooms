  "topPoints": [
    {
      "value": "Pale pink to lilac cap, 2.5–6 cm, narrowly pointed at first, then splitting at the edge and flaring like a ballet skirt.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Waxy gills, pink or paler.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "White stem, sometimes flushed pink near the top, that splits easily; no ring.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In old grassland that has never been fertilised — sheep-grazed hills, lawns, churchyards.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Old grassland, grazed or mown short and never fertilised — sheep-grazed hills, lawns, churchyards.",
    "sources": [
