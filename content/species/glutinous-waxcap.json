    {
      "value": "Small, very slimy cap in yellow to orange shades.",
      "sources": [
        "fn",
        "ns"
      ]
    },
    {
      "value": "The stem is very slimy too.",
      "sources": [
        "fn",
        "ns"
      ]
    },
    {
      "value": "Yellow to pale orange gills, broadly attached or running slightly down the stem.",
      "sources": [
        "fn",
        "ns"
      ]
    },
    {
      "value": "In short, unfertilised grassland such as lawns.",
      "sources": [
        "fn",
        "ns"
      ]
    }
  ],
