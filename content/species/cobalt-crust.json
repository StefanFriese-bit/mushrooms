  "topPoints": [
    {
      "value": "An intense dark blue, velvety crust spreading over dead wood, with a paler edge.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Thin and waxy when wet, crusty and brittle when dry.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "On the undersides of dead branches and fallen logs of broadleaved trees, especially ash.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Dead branches and fallen logs of broadleaved trees, especially ash; also maple, oak and hazel.",
    "sources": [
      "fn",
      "wp"
    ]
  },
