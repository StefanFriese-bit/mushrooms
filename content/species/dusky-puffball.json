    },
    "fleshChange": {
      "value": "Pure white and spongy, turning yellowish-brown, then dark brown and powdery",
      "sources": [
        "wf",
        "fn"
      ]
    },
    "smell": {
      "value": "Faint, unpleasant and gassy when cut",
      "sources": [
        "fn"
      ]
    }
  },
