{
  "slug": "dusky-puffball",
  "inatId": 194080,
  "scientific": "Lycoperdon nigrescens",
  "english": "Dusky Puffball",
  "olderNames": [
    "Lycoperdon foetidum"
  ],
  "edibility": {
    "value": "not-edible",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "edibilityNote": {
    "value": "Reported inedible; First Nature calls it possibly suspect. Wild Food UK warns that breathing in the spores of old puffballs can harm the lungs.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "A small puffball, 2–4 cm across, pear- or club-shaped, covered in dark brown to almost black spines.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Darker than most puffballs and blackening with age; old ones lose their spines and look smooth and mottled.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Inside: white and spongy at first, then brown and powdery.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Mainly under conifers on acid soil; also in grass on heaths.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Mainly under conifers on acid soil; sometimes in grass on heaths and sand dunes.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
    "value": [
      6,
      7,
      8,
      9
    ],
    "sources": [
      "fn",
      "wf"
    ]
  },
  "sporePrint": {
    "value": "Olive (Wikipedia); the spore mass turns yellowish-brown, then dark brown (First Nature)",
    "sources": [
      "wp",
      "fn"
    ]
  },
  "features": {
    "underside": {
      "value": "other",
