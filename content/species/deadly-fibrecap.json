{
  "slug": "deadly-fibrecap",
  "inatId": 1112491,
  "scientific": "Inosperma erubescens",
  "english": "Deadly Fibrecap",
  "olderNames": [
    "Inocybe patouillardii",
    "Inocybe erubescens"
  ],
  "edibility": {
    "value": "deadly",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "Contains enough muscarine to kill. Do not taste it, not even a tiny bit.",
    "sources": [
      "wp",
      "fn",
      "wf"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Cap white to cream, silky, with fine fibres running out from the centre; the edge often splits.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Turns red: cap, gills and stem redden where bruised and with age.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills whitish, turning pinkish to dull brown; dull brown spore print.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Under beech and other broadleaved trees on chalky soil, often at woodland edges, from late spring.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Under broadleaved trees, especially beech and hornbeam, on chalky or neutral soil; often at woodland edges.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
    "value": [
      5,
      6,
      7,
      8,
      9
    ],
    "sources": [
      "fn",
      "wf"
    ]
  },
  "sporePrint": {
    "value": "Dull brown",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
