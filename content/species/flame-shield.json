  "topPoints": [
    {
      "value": "Bright flame-orange cap, smooth or finely wrinkled.",
      "sources": [
        "fn",
        "ns"
      ]
    },
    {
      "value": "Free gills, white at first, turning pinkish.",
      "sources": [
        "fn",
        "ns"
      ]
    },
    {
      "value": "Stem paler above and more orange towards the base.",
      "sources": [
        "fn",
        "ns"
      ]
    },
    {
      "value": "On rotting wood of broadleaved trees, especially elm.",
      "sources": [
        "fn",
        "ns"
      ]
    }
  ],
  "habitat": {
    "value": "Rotting stumps, fallen branches and buried wood of broadleaved trees, especially elm.",
    "sources": [
      "fn",
