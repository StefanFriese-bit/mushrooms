  "topPoints": [
    {
      "value": "A tall puffball shaped like a pestle: a round head on a thick, stem-like base.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "White at first, covered in soft pointed warts that rub off; it turns ochre to brown.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Inside: white and firm when young, then olive-brown spores.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "In woods, especially edges and clearings; sometimes grassland.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Broadleaved and conifer woods, especially edges and clearings; sometimes grassland and hedgerows.",
    "sources": [
      "fn",
      "wf"
    ]
  },
