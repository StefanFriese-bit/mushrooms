  "topPoints": [
    {
      "value": "White cap covered in fine grey-brown scales, densest and darkest in the centre.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Unpleasant smell of ink or carbolic soap, strongest when bruised or cut.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Bruises yellow, most at the stem base; the yellow later turns brown.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills pink, then brown; a large white hanging ring.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Broadleaved woods and under hedges, alone or in small groups; now and then in grass.",
    "sources": [
      "fn",
      "wf"
    ]
  },
