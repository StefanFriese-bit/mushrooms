  "topPoints": [
    {
      "value": "Large grey to brownish-grey cap, 6–20 cm, often with a whitish bloom; it ends up flat or slightly funnel-shaped.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Gills crowded, white to pale cream, running a little down the stem.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Cream to pale buff spore print.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Often in large rings in broadleaved and conifer woods and under hedges, in autumn.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
