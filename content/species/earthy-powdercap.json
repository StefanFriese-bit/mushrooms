    ]
  },
  "edibilityNote": {
    "value": "Some guides call it edible, but most now say not: Wikipedia warns that the deadly Chestnut Dapperling (Lepiota castanea) looks like it, and First Nature that some deadly webcaps and poisonous dapperlings are orange too.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Small ochre-yellow to orange-brown cap, 1–5 cm, dry and finely granular, as if powdered.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Crowded white gills, turning cream.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Stem with a small, fleeting ring; scaly and granular below it, smooth above.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "A musty, earthy smell.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In mossy grassland, heaths, conifer clearings and woodland edges.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Mossy grassland, heaths, conifer clearings and woodland edges; even the mossy edges of bogs.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "seasonMonths": {
