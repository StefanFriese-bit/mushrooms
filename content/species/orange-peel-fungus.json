  "topPoints": [
    {
      "value": "Bright orange cups, 1–10 cm, often split and wavy, like discarded orange peel.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Outside paler and finely downy; no real stem.",
      "sources": [
        "wf",
        "wp"
      ]
    },
    {
      "value": "On bare, disturbed soil and gravel, often beside paths.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "On bare or disturbed soil, gravel and compacted ground, often beside paths.",
