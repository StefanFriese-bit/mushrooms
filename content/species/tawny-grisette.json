  "topPoints": [
    {
      "value": "Tawny orange-brown cap, 5–8 cm, with a grooved, paler edge and usually no white flecks.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "No ring on the stem.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "A large white bag (volva) at the base of the stem.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Gills white, free and crowded; white spore print.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Broadleaved and conifer woods, often with birch or oak and beside paths.",
    "sources": [
      "fn",
      "wp"
    ]
  },
