  "edibilityNote": {
    "value": "Edible but not one of the best: it smells unpleasant and tastes metallic when cooked. Some people find Suillus boletes upset them — peel the cap, remove the pores and cook thoroughly (First Nature).",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
