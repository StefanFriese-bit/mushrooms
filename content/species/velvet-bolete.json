    ]
  },
  "topPoints": [
    {
      "value": "A yellowish-brown to rusty cap, 6–13 cm, finely velvety or scaly, dry except in wet weather.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Underneath: mustard to olive-ochre pores.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "No ring on the stem — unlike the Larch Bolete.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Under Scots pine on acid heaths, moors and plantations.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Conifer woods on acid soil — heaths, moors and plantations — mostly with Scots pine.",
