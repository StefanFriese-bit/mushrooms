  "topPoints": [
    {
      "value": "A small, kidney-shaped, bristly brown cap, 1–3 cm, on a stem attached at its edge.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Underneath: tiny teeth, whitish at first, then brown.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Always on fallen pine cones, often half buried.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Fallen cones of pines, especially Scots pine, often half buried; sometimes conifer litter.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "seasonMonths": {
