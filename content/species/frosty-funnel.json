  ],
  "edibility": {
    "value": "deadly",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "Contains muscarine: sweating, drooling, vomiting and diarrhoea within half an hour of eating it.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "White cap, 3–10 cm, with a frosty, chalky coating; buff or pinkish spots near the centre; flat to slightly sunken.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Gills white to cream, crowded, joined to the stem or running down it.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Spore print cream with a pinkish-buff tinge, not pure white.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In leaf litter in broadleaved and conifer woods, and on verges under hedges.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "In leaf litter in broadleaved and conifer woods, and on grassy verges under hedges.",
    "sources": [
      "fn",
