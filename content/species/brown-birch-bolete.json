  "topPoints": [
    {
      "value": "Underneath: off-white to greyish pores — no gills.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Cap in shades of brown, smooth, sticky when wet.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Stem white to grey, covered in small dark scales that look like dirt.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Flesh white; it stays white or turns slightly pink when cut — never blue.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Only under birch trees.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
