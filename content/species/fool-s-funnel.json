{
  "slug": "fool-s-funnel",
  "inatId": 1525557,
  "scientific": "Collybia rivulosa",
  "english": "Fool's Funnel",
  "olderNames": [
    "Clitocybe rivulosa"
  ],
  "edibility": {
    "value": "deadly",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "Contains muscarine: sweating, drooling and tears within half an hour, then stomach pains, sickness and blurred vision. Deaths are rare but have happened. Do not taste it.",
    "sources": [
      "fn",
      "wp",
      "wf"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Small white cap, 1–6 cm, chalky or floury, flat to slightly sunken, with the edge rolled under.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills crowded, white to cream, running down the stem.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "White spore print; no distinctive smell.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "In grass — lawns, pasture, verges and parks — often in rings, like the Fairy Ring Champignon.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Lawns, pasture, roadside verges, parks and path edges, often in rings or troops; also coastal dunes.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
