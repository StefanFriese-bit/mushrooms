  "topPoints": [
    {
      "value": "Large golden-orange cap, 4–30 cm, fibrous and finely scaly.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills yellow, turning rusty orange-brown; rusty-brown spore print.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Stout stem with a ring that turns rusty with spores.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "In clusters at the base of living trees and on stumps, mostly broadleaved.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "In clusters at the base of living trees and on stumps and logs, mostly broadleaved; sometimes conifers.",
    "sources": [
      "fn",
      "wf"
    ]
  },
