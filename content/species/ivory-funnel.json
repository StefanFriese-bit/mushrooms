  },
  "edibilityNote": {
    "value": "Contains muscarine: sweating, drooling and tears within half an hour, then stomach pains, sickness and blurred vision. Deaths are rare but have happened. Do not taste it.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Small white cap, 1–6 cm, sometimes dusted buff, flat to slightly sunken.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Gills crowded, white, joined to the stem or running down it.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "White spore print; no distinctive smell.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In grass — lawns, meadows, verges and parks — often in rings.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
