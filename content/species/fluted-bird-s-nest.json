    {
      "value": "Tiny cups, 6–10 mm, like birds' nests holding small grey \"eggs\".",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "The inside of each cup is fluted with fine grooves; the outside is hairy and brown.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In clusters on dead wood, twigs and woodchip.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
