  "topPoints": [
    {
      "value": "A small, pointed cap, 0.5–2.5 cm, often with a sharp nipple on top; brown when wet, drying pale buff.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills grey, turning purple-black; dark purple-brown spore print.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Thin, wavy, pale stem, sometimes blue at the base.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "In grazed grassland, upland pasture, lawns and parks — never on dung.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Grazed grassland, upland pasture and moors, also lawns and parks; it does not grow on dung.",
