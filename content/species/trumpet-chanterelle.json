  "topPoints": [
    {
      "value": "Small brown funnel-shaped cap, 2–5 cm, with a wavy edge; often a hole runs through the middle into the stem.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Underneath: pale, blunt, forked folds running down the stem — not true gills.",
      "sources": [
        "wf",
        "wp",
        "fn"
      ]
    },
    {
      "value": "Stem yellow and hollow, often flattened or grooved.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Among moss in damp conifer and beech woods, from late summer into winter.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Among moss and rotting wood in damp conifer and mixed woods, often with beech or among ivy.",
    "sources": [
      "fn",
      "wf"
    ]
  },
