        "fn",
        "wp"
      ]
    },
    {
      "value": "A very strong, unpleasant smell, like coal gas.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Thick, widely spaced yellow gills, notched at the stem; no ring.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Mostly under oak and beech.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
