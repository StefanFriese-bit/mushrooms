{
  "slug": "silky-rosegill",
  "inatId": 128074,
  "scientific": "Volvariella bombycina",
  "english": "Silky Rosegill",
  "olderNames": [
    "Volvaria bombycina"
  ],
  "edibility": {
    "value": "edible-cooked",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "It grows from a bag like the deadly Amanitas: check for pink gills, a pink spore print and no ring, and that it is growing on wood. Wild Food UK leaves it alone because it is uncommon.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Silky, hairy white cap, 5–20 cm, egg-shaped then bell-shaped.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills free, white turning pink; pink spore print.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "A white stem with no ring, growing from a large bag (volva).",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "On wood: dead or damaged trunks of elm, maple, beech and other broadleaved trees.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "On dead trunks and large branches, or knots and wounds of living broadleaved trees — elm, maple, beech, oak.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "seasonMonths": {
    "value": [
      7,
      8,
      9,
      10,
      11
    ],
    "sources": [
      "fn",
      "wf"
    ]
  },
