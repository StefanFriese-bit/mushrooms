    {
      "value": "Bell-shaped grey-brown to reddish-brown caps, 1–4.5 cm, lined almost to the centre, with a toothed edge.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Stems pale at the top, darker red-brown below, downy at the base; no ring.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In dense clusters on dead oak stumps and logs.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
