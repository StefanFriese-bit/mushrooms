{
  "slug": "false-chanterelle",
  "inatId": 63538,
  "scientific": "Hygrophoropsis aurantiaca",
  "english": "False Chanterelle",
  "olderNames": [
    "Clitocybe aurantiaca",
    "Cantharellus aurantiacus"
  ],
  "edibility": {
    "value": "poisonous",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "Reported to cause stomach upsets and, in some people, hallucinations. Older books called it edible.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Thin, crowded gills that fork again and again and run down the stem.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Orange to orange-yellow, the gills often brighter orange than the cap.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Cap 2–8 cm, a shallow funnel with its edge rolled under.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "No fruity apricot smell.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Mostly in conifer woods and on heaths, on the ground or on rotting wood.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "White spore print.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Mainly conifer woods and heathland, sometimes with broadleaved trees; on the ground, on rotting wood or on woodchips.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "seasonMonths": {
    "value": [
      6,
      7,
      8,
      9,
      10,
      11
    ],
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "sporePrint": {
    "value": "White to cream",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
