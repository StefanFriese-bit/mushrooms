  "topPoints": [
    {
      "value": "A fan- or kidney-shaped bracket, 5–20 cm, with concentric brown zones on top, darkening with age.",
      "sources": [
        "fn",
        "wp",
        "wt-bracket"
      ]
    },
    {
      "value": "Underneath: pale slits and mazes rather than round pores; it bruises pinkish-brown when pressed.",
      "sources": [
        "fn",
        "wf",
        "wt-bracket"
      ]
    },
    {
      "value": "On dead broadleaved wood, especially willow, also birch and beech.",
      "sources": [
        "fn",
        "wf",
        "wt-bracket"
      ]
    }
  ],
  "habitat": {
    "value": "Dead or dying broadleaved wood, especially willow (often by rivers), also birch and beech; alone or in tiers.",
    "sources": [
      "fn",
      "wf",
      "wt-bracket"
    ]
  },
