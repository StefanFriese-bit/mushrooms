  "topPoints": [
    {
      "value": "A lilac to purple-brown cap, 5–14 cm, with a central bump and fine radiating fibres.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Gills white, turning pink; pale pink spore print.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "A fibrous stem the colour of the cap or paler; no ring.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In moist, old grassland, often in the uplands.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Moist, old unfertilised grassland, upland and lowland.",
