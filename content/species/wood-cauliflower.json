  "topPoints": [
    {
      "value": "A large, rounded mass of flat, wavy, curly lobes, white to cream — like a cauliflower or a sponge.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "No cap and no gills: the folded lobes carry the spores.",
      "sources": [
        "wf",
        "wp"
      ]
    },
    {
      "value": "At the base of conifers, especially pine, growing from the roots.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "At the base of conifer trunks and on their roots, especially pine; also spruce, larch and others.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
