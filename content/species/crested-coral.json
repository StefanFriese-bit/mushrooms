  "topPoints": [
    {
      "value": "A white to cream coral, up to 7–8 cm tall, its branches ending in frilly, crested tips.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "A few flattened branches rise from a short base; the tips brown with age.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "On the ground under broadleaved trees and conifers, often beside paths.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "On the ground in broadleaved and conifer woods, often beside paths; sometimes on rotten wood.",
