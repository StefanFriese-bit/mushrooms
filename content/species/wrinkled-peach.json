  "topPoints": [
    {
      "value": "Peach to salmon-pink cap, 5–10 cm, covered in a net of wrinkled veins, with a rubbery skin.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills pink; very pale pink spore print.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Stem pink with white fibres, often curved; it can weep red droplets.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "On rotting elm, sometimes other broadleaved wood.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "On well-rotted fallen trunks and branches of broadleaved trees, usually elm.",
    "sources": [
      "fn",
