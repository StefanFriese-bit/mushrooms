  "topPoints": [
    {
      "value": "Cap white to cream (sometimes buff), thick and firm, often misshapen.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills white to cream, narrow and very crowded.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Strong mealy smell, like fresh flour or cucumber.",
      "sources": [
        "fn",
        "wp",
        "wf"
      ]
    },
    {
      "value": "In spring, in grassland near trees and hedges and on roadside verges, often in rings.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Grassland and pasture near trees and hedges, mown roadside verges, lawns and woodland edges; often in rings, mostly on chalk or limestone.",
    "sources": [
      "fn",
      "wf"
    ]
  },
