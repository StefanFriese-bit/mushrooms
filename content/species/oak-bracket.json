  "topPoints": [
    {
      "value": "A big, lumpy, cushion-shaped bracket, 5–40 cm or more, at the foot of an oak.",
      "sources": [
        "fn",
        "wp",
        "wt"
      ]
    },
    {
      "value": "When young it weeps drops of amber liquid, as if dripping honey.",
      "sources": [
        "fn",
        "wt"
      ]
    },
    {
      "value": "Underneath: buff to greyish pores, darkening to brown.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "At or near the base of living and dead broadleaved trees, nearly always oak.",
    "sources": [
      "fn",
      "wf",
