  "topPoints": [
    {
      "value": "Cap white to pale grey, soft like suede, with a wavy edge and a sunken centre.",
      "sources": [
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills running down the stem, white turning pink; pink spore print.",
      "sources": [
        "wf",
        "wp"
      ]
    },
    {
      "value": "Strong smell of raw dough, flour or cucumber.",
      "sources": [
        "wf",
        "wp"
      ]
    },
    {
      "value": "In woodland clearings and edges, hedgerows and roadsides.",
      "sources": [
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Clearings and edges of broadleaved and conifer woods, hedgerows and roadsides; sometimes in grass.",
    "sources": [
      "wf",
      "wp"
    ]
  },
