  "topPoints": [
    {
      "value": "Tan to brown cap, 4–12 cm, woolly-fibrous, with ragged white veil threads on the edge.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Gills mottled dark brown to black, with pale edges that \"weep\" black droplets when damp.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "A ring zone of fibres on the stem, blackened by spores; black spore print.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "In grass: verges, lanes and woodland glades.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Grassland, verges beside lanes and woodland glades.",
