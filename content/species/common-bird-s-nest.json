  "topPoints": [
    {
      "value": "Tiny felty cups, 4–10 mm across, holding several white \"eggs\" — like a bird's nest.",
      "sources": [
        "fn",
        "wt",
        "wp"
      ]
    },
    {
      "value": "Young cups are sealed with a velvety, cinnamon-yellow lid, which splits away to show the eggs.",
      "sources": [
        "fn",
        "wt",
        "wf"
      ]
    },
    {
      "value": "In clusters on dead twigs, rotting wood and woodchip.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "In clusters on fallen twigs, rotting wood, woodchip and decaying plant matter.",
    "sources": [
      "fn",
