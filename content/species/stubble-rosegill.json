    ]
  },
  "edibilityNote": {
    "value": "It grows from a bag like the deadly Amanitas: check for pink gills, a pink spore print and no ring. Wild Food UK advises leaving it, as its fields are often sprayed.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "White to grey cap, 5–15 cm, often with a darker centre, sticky when wet.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills free, white at first, turning pink; pink spore print.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "A white stem with no ring, growing from a loose bag (volva).",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "In rich ground: pasture, stubble fields, verges, compost and woodchip.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Rich ground: damp pasture, stubble fields, roadside grass, gardens, compost and woodchip.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
