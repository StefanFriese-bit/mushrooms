{
  "slug": "orange-birch-bolete",
  "inatId": 343661,
  "scientific": "Leccinum versipelle",
  "english": "Orange Birch Bolete",
  "olderNames": [
    "Leccinum testaceoscabrum"
  ],
  "edibility": {
    "value": "edible-cooked",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "Mildly poisonous unless cooked well: fry or boil it for 15 to 20 minutes. Never eat it raw.",
    "sources": [
      "wf",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Cap orange to orange-brown, large and domed.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Underneath: small pores, mouse-grey to pale — no gills.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Stem whitish, covered in black woolly scales; it can be longer than the cap is wide.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Cut flesh turns grey, blue-green and then almost black, especially at the base of the stem.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Only under birch, often on heaths and at wood edges.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Under birch, mainly on acid heathland, at wood edges and in scrub.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "seasonMonths": {
    "value": [
