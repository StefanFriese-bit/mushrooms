  "topPoints": [
    {
      "value": "Brown cap, 3–14 cm, streaked with darker fibres, bell-shaped then flat.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Crowded gills, free of the stem, white turning pink; pink spore print.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "White stem streaked with dark fibres; no ring.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "On rotting stumps, logs, woodchip and sawdust of broadleaved trees.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Stumps, fallen branches and woody debris of broadleaved trees, rarely conifers; also woodchip and sawdust heaps.",
    "sources": [
      "fn",
      "wf"
    ]
  },
