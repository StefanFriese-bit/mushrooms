  "topPoints": [
    {
      "value": "A round, funnel-shaped cap, 2–12 cm, ochre to orange-brown with small flat scales — like a small Dryad's Saddle.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Underneath: white to cream angular pores running down a short pale stem.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "On buried and fallen dead wood of broadleaved trees, especially beech.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Buried and fallen dead wood of broadleaved trees, especially beech, also oak and rowan.",
    "sources": [
      "fn",
      "wf"
    ]
  },
