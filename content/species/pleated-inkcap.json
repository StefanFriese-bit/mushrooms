  "topPoints": [
    {
      "value": "A tiny, deeply pleated pale grey cap, 1–3.5 cm, like a cocktail umbrella, with a tawny centre.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Gills white, then grey, then black; black spore print.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "A thin, very fragile white stem, up to 6 cm.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In short grass on lawns and in parks; it shrivels within a day.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Short grass on lawns, parks and meadows; sometimes leaf litter and woodchip.",
    "sources": [
      "fn",
      "wp"
    ]
  },
