  "topPoints": [
    {
      "value": "Shiny black jelly spreading over dead branches in brain-like masses, 5–15 cm across.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Dries to a thin crust and swells again after rain.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "On dead broadleaved branches — beech, ash, hazel — all year, most in autumn to spring.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Dead attached and fallen branches of broadleaved trees — beech, ash, hazel; rarely conifers.",
    "sources": [
      "fn",
      "wp"
    ]
  },
