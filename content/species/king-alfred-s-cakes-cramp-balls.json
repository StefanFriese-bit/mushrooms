  "topPoints": [
    {
      "value": "Hard, rounded lumps 2–8 cm across on dead wood, brown at first, then shiny black like lumps of coal.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Cut in half: rings of grey or purple-brown and black inside, like tree rings.",
      "sources": [
        "wf",
        "wp"
      ]
    },
    {
      "value": "Mostly on dead or dying ash.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "On dead or dying broadleaved wood, nearly always ash; sometimes beech.",
