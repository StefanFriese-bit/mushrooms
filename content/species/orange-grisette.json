  },
  "topPoints": [
    {
      "value": "Orange to yellow-orange cap, 5–12 cm, with a grooved edge and a darker centre.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Pale orange stem with a zig-zag \"snakeskin\" pattern; no ring.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "A white bag (volva) at the base of the stem.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Gills cream, free and crowded; white spore print.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Broadleaved woods, especially with birch and beech, often in mossy clearings; sometimes with conifers.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
    "value": [
