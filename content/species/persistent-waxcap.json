  "topPoints": [
    {
      "value": "Pointed, conical yellow cap, often orange or reddish at the centre, sticky when wet.",
      "sources": [
        "fn",
        "ns"
      ]
    },
    {
      "value": "The cap edge is irregular and soon splits.",
      "sources": [
        "fn",
        "ns"
      ]
    },
    {
      "value": "Gills free or only narrowly attached, pale yellow, turning orange.",
      "sources": [
        "fn",
        "ns"
      ]
    },
    {
      "value": "Does not turn black when handled or old — unlike the Blackening Waxcap.",
      "sources": [
        "fn",
        "ns"
      ]
    }
  ],
  "habitat": {
    "value": "Grassland.",
    "sources": [
      "fn",
      "ns"
    ]
  },
