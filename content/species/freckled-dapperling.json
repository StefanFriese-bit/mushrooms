      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "A tan to pale brown cap, 6–18 cm, covered in dark brown pointed (pyramid) scales, densest in the middle.",
      "sources": [
        "wf",
        "wp"
      ]
    },
    {
      "value": "Crowded white gills, free of the stem.",
      "sources": [
        "wf",
        "wp"
      ]
    },
    {
      "value": "A ring, cottony on top with brown scales underneath; brown scales on the stem below.",
      "sources": [
        "wf",
        "wp"
      ]
    },
    {
      "value": "In broadleaved woods and on woodchip in parks and gardens.",
      "sources": [
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Broadleaved woods, and woodchip mulch in parks and gardens; commoner in southern Britain.",
    "sources": [
      "wf",
      "wp"
    ]
  },
