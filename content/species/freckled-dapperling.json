    ]
  },
  "edibilityNote": {
    "value": "It causes a reaction with alcohol, like the Common Inkcap, and may be poisonous (Wikipedia); Wild Food UK lists it as poisonous.",
    "sources": [
      "wf",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
