  "topPoints": [
    {
      "value": "Grey-brown to pinkish bell-shaped cap, 2.5–6 cm, with fine lines towards a paler edge.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills white to pinkish-grey, joined by cross-veins like ladder rungs.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Tough, thin, often twisted stem, pale at the top; no ring.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "In clusters on stumps and dead wood of broadleaved trees.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Stumps, trunks and dead wood of broadleaved trees, occasionally conifers, including buried wood.",
    "sources": [
      "fn",
      "wf"
    ]
  },
