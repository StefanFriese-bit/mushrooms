  "topPoints": [
    {
      "value": "A pale blue-green, sticky cap, 2–8 cm, fading to tan or yellowish; white scales mainly near the edge when young.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills grey, turning purple-brown, without white edges.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "A ring on the stem that browns with fallen spores; pale blue-green and scaly below it.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "In grass, roadsides, gardens and woodchip, and in woods.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Meadows, roadsides, hedgerows, gardens and woodchip; also mixed woods and heaths.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
