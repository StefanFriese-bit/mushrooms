{
  "slug": "grey-knight",
  "inatId": 341797,
  "scientific": "Tricholoma terreum",
  "english": "Grey Knight",
  "olderNames": [
    "Agaricus terreus",
    "Tricholoma myomyces",
    "Tricholoma gausapatum"
  ],
  "edibility": {
    "value": "deadly",
    "sources": [
      "wf",
      "fn"
    ]
  },
  "edibilityNote": {
    "value": "Once sold as edible. Toxins that can cause rhabdomyolysis — muscle breakdown that can fatally damage the kidneys — were reported in 2014, so First Nature and Wild Food UK say never eat it; Wikipedia reports later studies that found the risk small.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Mouse-grey cap, 3–10 cm, covered in fine grey woolly fibres; conical, then flat with a slight hump.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills white turning grey, crowded, notched where they meet the stem.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Stem plain and white; no ring.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "In groups under pines and other conifers.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Under pines (especially Scots pine) and other conifers, often on chalky or neutral soil; usually in groups, often along path edges.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
    "value": [
      8,
      9,
      10
    ],
    "sources": [
      "fn",
      "wf"
    ]
  },
  "sporePrint": {
    "value": "White",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
