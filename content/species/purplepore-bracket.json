  "topPoints": [
    {
      "value": "Small thin brackets, 1–6 cm across, often in tiers or fused rows on dead conifer wood.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Upper surface whitish to grey, hairy and zoned, often stained green by algae.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Underneath: bright purple to violet pores, fading to brown with age; the purple stays longest at the edge.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "On dead conifer logs and stumps while the bark is still on; all year.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Dead conifer wood — logs, trunks and stumps with the bark still on, mostly fir, spruce, larch and pine; very rarely broadleaved wood.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
