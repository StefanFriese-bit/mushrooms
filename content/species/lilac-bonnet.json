  "topPoints": [
    {
      "value": "A lilac to pinkish cap, 2–6 cm, lined towards the edge, often paler in dry weather.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Smells of radish when crushed.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Gills pale grey with a lilac tint; a thin, often twisted stem.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "In leaf litter in broadleaved and conifer woods.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
