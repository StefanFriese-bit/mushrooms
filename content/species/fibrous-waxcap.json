  "topPoints": [
    {
      "value": "A large orange-yellow waxcap, 3–11 cm, reddish when young, with a dry, fibrous, scurfy cap that often splits.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "A dry stem streaked with reddish fibres; no ring.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Thick, fairly widely spaced, pale yellowish gills.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In old, unfertilised grassland.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Old, unfertilised grassland on chalky to mildly acid soil; occasionally sand dunes.",
