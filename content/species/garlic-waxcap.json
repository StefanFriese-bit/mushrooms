  "topPoints": [
    {
      "value": "A small scarlet cap, 0.8–2.5 cm, dry and covered in tiny upright scales, fading to orange.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Crushed, its gills smell of garlic.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Orange-red to pale yellow gills; a thin scarlet stem with no ring.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In damp, old, unfertilised grassland and heath.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
