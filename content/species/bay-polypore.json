  "topPoints": [
    {
      "value": "A smooth, shiny chestnut-brown cap, 4–25 cm, often funnel-shaped in the middle with a thin, wavy edge.",
      "sources": [
        "wf",
        "wp"
      ]
    },
    {
      "value": "Underneath: tiny white to cream pores, running down the stem.",
      "sources": [
        "wf",
        "wp"
      ]
    },
    {
      "value": "A short stem, often off-centre, black at the base.",
      "sources": [
        "wf",
        "wp"
      ]
    },
    {
      "value": "On fallen dead wood of broadleaved trees.",
      "sources": [
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Fallen dead wood of many broadleaved trees — elm, beech, alder, birch, oak, willow; rarely conifers.",
