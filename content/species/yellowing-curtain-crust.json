  "topPoints": [
    {
      "value": "Thin fan-shaped brackets, 3–7 cm, with wavy edges, often in overlapping tiers.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Upper side zoned, velvety to smooth, reddish-orange fading to greyish ochre, often green with algae.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Underside smooth — no pores — and it stains yellow when scratched or cut.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "On dead beech and other broadleaved wood, all year.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Dead trunks and fallen branches of broadleaved trees, especially beech and sycamore.",
    "sources": [
      "fn",
