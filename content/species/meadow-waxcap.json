  "topPoints": [
    {
      "value": "Pale apricot to orange-buff cap, 2–7 cm, dry and smooth, often with a broad hump.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Thick, widely spaced gills running far down the stem.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Stout stem, pale at first, later the colour of the cap; no ring.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In old, unfertilised grassland and sheep-grazed pasture.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Old, unfertilised short grassland, lawns and sheep-grazed pastures.",
    "sources": [
      "fn",
      "wp"
    ]
  },
