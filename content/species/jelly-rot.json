  "topPoints": [
    {
      "value": "A flat, translucent, rubbery crust up to 10 cm, whose upper edge curls out into small hairy white brackets.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "The exposed surface is orange-pink and wrinkled into a net of folds.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "On dead broadleaved trunks and branches, especially in autumn and winter.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Dead trunks, stumps and fallen branches of broadleaved trees, especially oak, beech and birch; rarely conifers.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
