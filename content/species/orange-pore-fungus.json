    {
      "value": "A small, bright orange fan or kidney shape, 0.5–3 cm, on a short side stem.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Underneath: large, prominent orange pores.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "On rotting wood in damp, shady woods — an introduced species, first found in Britain in 2012.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
