{
  "slug": "deceiver",
  "inatId": 63236,
  "scientific": "Laccaria laccata",
  "english": "Deceiver",
  "olderNames": [
    "Clitocybe laccata"
  ],
  "edibility": {
    "value": "edible-cooked",
    "sources": [
      "fn",
      "wf",
