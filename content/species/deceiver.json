    ]
  },
  "edibilityNote": {
    "value": "Use only the caps; the stems are tough. Many small brown mushrooms are dangerous — the deadly Funeral Bell grows on wood and has a ring.",
    "sources": [
      "wf",
      "wp",
      "fn"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Small cap, 1.5–7 cm, salmon-pink, orange or reddish-brown, fading to buff as it dries.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Thick, widely spaced gills the colour of the cap; white spore print.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Tough, fibrous, often twisted stem; no ring.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "In leaf litter in woods and on heaths, often in large numbers.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Leaf litter in all kinds of woodland, on heaths, in parks and beside paths.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
    "value": [
      6,
