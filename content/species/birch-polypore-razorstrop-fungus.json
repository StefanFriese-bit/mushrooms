  "topPoints": [
    {
      "value": "A thick, rounded bracket up to 25–30 cm across, smooth and grey-brown to cream on top.",
      "sources": [
        "fn",
        "wp",
        "wt-bracket"
      ]
    },
    {
      "value": "Underneath: white, very small pores, turning buff with age.",
      "sources": [
        "fn",
        "wp",
        "wt-bracket"
      ]
    },
    {
      "value": "Only on birch — living, dying or dead trunks — often several up one trunk like steps.",
      "sources": [
        "fn",
        "wp",
        "wt-bracket"
      ]
    }
  ],
  "habitat": {
    "value": "Only on birch: living, dying and dead trunks, in any birch wood.",
    "sources": [
