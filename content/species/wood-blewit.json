  "topPoints": [
    {
      "value": "Stocky mushroom with a lilac-tinged cap, 6–15 cm, fading to tan with age.",
      "sources": [
        "fn",
        "wf",
        "wp",
        "wt"
      ]
    },
    {
      "value": "Gills crowded, lilac to violet when young, turning buff.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Stout, violet-tinged stem, often swollen at the base; no ring.",
      "sources": [
        "fn",
        "wf",
        "wt"
      ]
    },
    {
      "value": "Pale pinkish-buff spore print — purple webcaps print rusty brown.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Leaf litter in mixed woodland, often in rings; also hedgerows, gardens and compost heaps.",
    "sources": [
      "fn",
      "wf"
    ]
  },
