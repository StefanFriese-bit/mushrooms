  "topPoints": [
    {
      "value": "Small grey-brown cap, 1–5 cm, bell-shaped and never flat, with white tooth-like fringes hanging from the rim.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Grey-brown gills that become mottled, then black; black spore print.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "A tall, thin stem, 6–12 cm, finely powdered white; no ring.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "On dung and in manured pasture.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "On dung or well-manured soil, in pastures and grazed commons.",
    "sources": [
      "fn",
