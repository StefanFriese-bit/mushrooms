  "edibility": {
    "value": "not-edible",
    "sources": [
      "wf",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "First Nature reports children falling ill after eating it and advises treating it as toxic; Wikipedia notes it is sometimes mistaken for a hallucinogenic mottlegill.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Small brown cap, 1–4 cm, bell-shaped then convex, drying to beige from the centre outwards.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills pale brown, becoming mottled with dark brown spots; dark brown spore print.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Thin, pale stem with no ring.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "On lawns, verges and other short grass, often in groups — the \"mower's mushroom\".",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Lawns, roadside verges, parks, cemeteries and other short grass, in groups.",
    "sources": [
      "fn",
      "wf"
    ]
  },
