    ]
  },
  "topPoints": [
    {
      "value": "Cap a honeycomb of pits and narrow ridges, pale cream, tan or grey-brown.",
      "sources": [
        "fn",
        "wf",
        "wp",
        "wt"
      ]
    },
    {
      "value": "Cut it top to bottom: one single hollow from the tip of the cap to the base of the stem.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "The cap is joined to the stem at its lower edge.",
      "sources": [
        "wf",
        "wp"
      ]
    },
    {
      "value": "Stem white or cream, hollow, often swollen at the base.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "In spring, often on chalk or limestone, under trees, in gardens and on waste ground.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Under broadleaved trees on chalky or limy soil; also gardens, verges, waste ground and dunes.",
    "sources": [
      "fn",
      "wf"
    ]
  },
  "seasonMonths": {
    "value": [
      3,
      4,
      5
    ],
