    ]
  },
  "edibilityNote": {
    "value": "Many guides call it edible, but it is easily confused with other yellow waxcaps, some of unknown edibility and some listed as poisonous. It is also on several countries' lists of threatened fungi.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Bright yellow to orange-yellow cap, 2–7.5 cm, slimy when wet, domed then flat.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Gills pale yellow, thick and widely spaced.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Slimy yellow stem, the colour of the cap; no ring.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "In old, unfertilised grassland, lawns and roadsides.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Old, unfertilised grassland, meadows, heaths, lawns, roadsides and open woodland.",
    "sources": [
      "fn",
      "wf"
    ]
  },
