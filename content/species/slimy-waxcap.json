  "topPoints": [
    {
      "value": "Very slimy grey-brown cap, 1–5 cm, bell-shaped then flatter with a broad hump.",
      "sources": [
        "fn",
        "wf",
        "wp"
      ]
    },
    {
      "value": "Thick, waxy, widely spaced white to grey gills.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Slimy stem, the colour of the cap; no ring.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "In old grassland and pasture, churchyards and lawns.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Old grazed pasture, fields, churchyards and mown grass; sometimes open woodland.",
