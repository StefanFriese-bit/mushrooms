  "edibilityNote": {
    "value": "Edible only while young and pure white all through. First Nature warns that earthballs, some of them seriously poisonous, and young poisonous gilled mushrooms can look like it: cut each one top to bottom.",
    "sources": [
      "fn",
      "wf",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "A large, rounded to pear-shaped puffball, 6–15 cm across.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "White at first; its skin breaks into flakes like crazy paving.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Inside: pure white and spongy when young, then yellow, then brown spore powder.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "In old grassland — pastures and sheep-grazed hillsides.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Old grassland — permanent pasture, sheep-grazed hillsides, meadows and woodland edges.",
    "sources": [
      "fn",
      "wf"
    ]
  },
