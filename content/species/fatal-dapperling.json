  "topPoints": [
    {
      "value": "Small cap, 2–3.5 cm, covered in fine pinkish-brown scales in rings, paler towards the cream edge.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Gills white to cream, free of the stem; white spore print.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Stem short and cream, with patches of the cap's colour below a faint ring zone.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "In broadleaved and mixed woods, and in parks and lawns with rich soil.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Broadleaved and mixed woods, alone or in small groups; also lawns and parks with rich soil.",
