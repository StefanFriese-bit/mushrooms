  "topPoints": [
    {
      "value": "Thin, wavy-edged crusts that curl out into small brackets, 1–4 cm, often in tiers.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Dark chocolate to red-brown on top, ridged in bands and finely velvety, with a paler or rusty-orange edge.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Underside smooth or slightly warty, rusty brown — no gills or pores.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "Almost always on fallen oak, where the bark has come away.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Fallen dead wood of oak, mostly where bark has broken away; occasionally sweet chestnut.",
    "sources": [
      "fn",
      "wf"
    ]
  },
