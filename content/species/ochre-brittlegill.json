  },
  "edibilityNote": {
    "value": "Edible but mediocre, sometimes peppery; cook it thoroughly. Brittlegills are hard to name and a few are toxic: eat only ones you can name with complete certainty (First Nature).",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "Ochre-yellow cap, 4–12 cm, flat with a slight dip; the skin peels two-thirds of the way in.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "White to cream, brittle gills; white to pale cream spore print.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "White stem that greys slightly with age; no ring.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "Very common in conifer and broadleaved woods, often close to pines.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Conifer and broadleaved woods; very common, often close to pines.",
    "sources": [
      "fn",
