  "topPoints": [
    {
      "value": "Cap ochre to rusty brown, with the edge strongly rolled under.",
      "sources": [
        "fn",
        "wf",
        "wp",
        "wt"
      ]
    },
    {
      "value": "Gills pale yellow-brown, running down the stem; they bruise dark brown at once.",
      "sources": [
        "fn",
        "wf"
      ]
    },
    {
      "value": "No milk when the gills are cut — unlike a milkcap.",
      "sources": [
        "wf",
        "wp"
      ]
    },
    {
      "value": "Under birch and other broadleaved trees; also heaths, grassland and lawns.",
      "sources": [
        "fn",
        "wf"
      ]
    }
  ],
  "habitat": {
    "value": "Under birch and other broadleaved trees, on acid soil; also heaths, grassland and lawns.",
    "sources": [
