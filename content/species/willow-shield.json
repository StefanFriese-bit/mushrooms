  "edibility": {
    "value": "poisonous",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "edibilityNote": {
    "value": "Some sources list it as edible, but some forms contain psilocybin, a hallucinogen (First Nature; Wikipedia: psychoactive) — do not eat it.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "protectedInUk": {
    "value": false,
    "sources": [
      "wf-prot",
      "wp-s41"
    ]
  },
  "topPoints": [
    {
      "value": "A grey to grey-brown cap, 2–8 cm, often with blue or green tints and a darker centre.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "White gills, free of the stem, turning pink; pink spore print.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "A white stem; in some forms it bruises slightly blue-green.",
      "sources": [
        "fn",
        "wp"
      ]
    },
    {
      "value": "On rotting wood of willow, alder and other broadleaved trees.",
      "sources": [
        "fn",
        "wp"
      ]
    }
  ],
  "habitat": {
    "value": "Stumps, fallen branches and woody debris of broadleaved trees, especially willow; also alder, beech and oak.",
    "sources": [
      "fn",
      "wp"
    ]
  },
  "seasonMonths": {
    "value": [
